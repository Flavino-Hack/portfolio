---
/**
 * Skills — compétences techniques en 2 colonnes : Réseau / Dev.
 */
import Container from '@components/layout/Container.astro';

const network = {
  title: 'Réseau / Système',
  icon: 'network',
  items: [
    'TCP/IP, VLAN, Routage',
    'pfSense, MikroTik',
    'Windows Server, Active Directory',
    'Linux (Ubuntu, Debian, CentOS)',
    'Virtualisation (Proxmox, VMware)',
    'VPN (WireGuard, OpenVPN)',
    'Monitoring (Zabbix, Grafana)',
    'Sécurité réseau (pare-feu, IDS)',
  ],
};

const dev = {
  title: 'Développement',
  icon: 'code',
  items: [
    'Python, TypeScript, JavaScript',
    'Node.js, Astro, React',
    'PostgreSQL, MySQL, SQLite',
    'API REST, WebSockets',
    'Git, GitHub Actions',
    'Docker, Docker Compose',
    'Scripting Bash, automatisation',
    'Tests (Vitest, Playwright)',
  ],
};
---

<section
  id="skills"
  data-section="skills"
  class="section min-h-screen flex items-center py-20 scroll-mt-16"
>
  <Container size="wide">
    <div class="grid md:grid-cols-12 gap-10 items-start">
      <!-- Titre -->
      <div class="md:col-span-4">
        <p class="font-mono text-xs mb-3" style="color: var(--text-muted);">
          02 — Compétences
        </p>
        <h2
          class="text-3xl md:text-4xl font-bold tracking-tight leading-tight"
          style="color: var(--text-primary);"
        >
          Stack
          <br />
          technique
        </h2>
        <p class="text-sm mt-4 leading-relaxed" style="color: var(--text-secondary);">
          Ce que je maîtrise au quotidien — du câble au code.
        </p>
      </div>

      <!-- 2 colonnes -->
      <div class="md:col-span-8 grid md:grid-cols-2 gap-5">
        <!-- Réseau -->
        <div class="p-5 rounded-xl border glass" style="border-color: var(--glass-border);">
          <div class="flex items-center gap-3 mb-4">
            <div
              class="w-9 h-9 rounded-lg flex items-center justify-center shrink-0"
              style="background: var(--glass-bg); color: var(--accent); border: 1px solid var(--glass-border);"
            >
              <svg
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                viewBox="0 0 24 24"
                class="w-4 h-4"
              >
                <rect x="2" y="2" width="20" height="8" rx="2" />
                <rect x="2" y="14" width="20" height="8" rx="2" />
                <line x1="6" y1="6" x2="6.01" y2="6" />
                <line x1="6" y1="18" x2="6.01" y2="18" />
              </svg>
            </div>
            <h3 class="font-semibold text-base" style="color: var(--text-primary);">
              {network.title}
            </h3>
          </div>
          <ul class="space-y-2">
            {network.items.map((item) => (
              <li class="flex items-start gap-2 text-sm" style="color: var(--text-secondary);">
                <span class="font-mono text-[10px] mt-1 shrink-0" style="color: var(--text-muted);">
                  ▸
                </span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Dev -->
        <div class="p-5 rounded-xl border glass" style="border-color: var(--glass-border);">
          <div class="flex items-center gap-3 mb-4">
            <div
              class="w-9 h-9 rounded-lg flex items-center justify-center shrink-0"
              style="background: var(--glass-bg); color: var(--accent); border: 1px solid var(--glass-border);"
            >
              <svg
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                viewBox="0 0 24 24"
                class="w-4 h-4"
              >
                <polyline points="16 18 22 12 16 6" />
                <polyline points="8 6 2 12 8 18" />
              </svg>
            </div>
            <h3 class="font-semibold text-base" style="color: var(--text-primary);">
              {dev.title}
            </h3>
          </div>
          <ul class="space-y-2">
            {dev.items.map((item) => (
              <li class="flex items-start gap-2 text-sm" style="color: var(--text-secondary);">
                <span class="font-mono text-[10px] mt-1 shrink-0" style="color: var(--text-muted);">
                  ▸
                </span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </Container>
</section>
