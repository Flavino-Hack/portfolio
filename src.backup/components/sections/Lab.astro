---
import Container from '@components/layout/Container.astro';

const labItems = [
  {
    title: 'Home Lab Réseau',
    desc: 'pfSense + VLAN + VPN WireGuard sur Proxmox',
    tags: ['pfSense', 'Proxmox', 'WireGuard'],
  },
  {
    title: 'Monitoring Zabbix',
    desc: 'Supervision de 12 VMs avec alertes Telegram',
    tags: ['Zabbix', 'Python', 'Telegram API'],
  },
  {
    title: 'Lab Sécurité',
    desc: 'Environnement isolé pour tests pentest (Kali, DVWA)',
    tags: ['Kali', 'Docker', 'DVWA'],
  },
];
---

<section
  id="lab"
  data-section="lab"
  class="section min-h-screen flex items-center py-20 scroll-mt-16"
>
  <Container size="wide">
    <div class="grid md:grid-cols-12 gap-10 items-start">
      <div class="md:col-span-4">
        <p class="font-mono text-xs mb-3" style="color: var(--text-muted);">
          04 — Lab perso
        </p>
        <h2
          class="text-3xl md:text-4xl font-bold tracking-tight leading-tight"
          style="color: var(--text-primary);"
        >
          Mon terrain
          <br />
          d'expérimentation
        </h2>
        <p class="text-sm mt-4 leading-relaxed" style="color: var(--text-secondary);">
          Je maintiens un lab perso pour tester, casser, réparer. C'est là que j'apprends le plus.
        </p>
      </div>

      <div class="md:col-span-8 grid gap-4">
        {labItems.map((item) => (
          <div class="p-5 rounded-xl border glass" style="border-color: var(--glass-border);">
            <h3 class="text-lg font-semibold mb-2" style="color: var(--text-primary);">
              {item.title}
            </h3>
            <p class="text-sm mb-3" style="color: var(--text-secondary);">
              {item.desc}
            </p>
            <div class="flex flex-wrap gap-1.5">
              {item.tags.map((tag) => (
                <span
                  class="font-mono text-[10px] px-2 py-0.5 rounded border"
                  style="
                    border-color: var(--glass-border);
                    background: var(--glass-bg);
                    color: var(--text-secondary);
                  "
                >
                  {tag}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </Container>
</section>
