---
const links = [
  { href: '#hero', label: 'Accueil', icon: 'home' },
  { href: '#profil', label: 'Profil', icon: 'user' },
  { href: '#skills', label: 'Skills', icon: 'cpu' },
  { href: '#certifs', label: 'Certifs', icon: 'award' },
  { href: '#lab', label: 'Lab', icon: 'server' },
  { href: '#projets', label: 'Projets', icon: 'folder' },
  { href: '#contact', label: 'Contact', icon: 'mail' },
];
---

<nav
  id="mac-dock"
  class="fixed bottom-3 md:bottom-5 left-1/2 -translate-x-1/2 z-50 flex items-end gap-1 md:gap-1.5 px-2 py-1.5 md:px-3 md:py-2 rounded-2xl border"
  style="
    background: var(--glass-bg);
    border-color: var(--glass-border);
    backdrop-filter: blur(32px) saturate(220%);
    -webkit-backdrop-filter: blur(32px) saturate(220%);
    box-shadow:
      0 20px 48px rgba(0, 0, 0, 0.4),
      inset 0 1px 0 var(--glass-highlight),
      inset 0 -1px 0 rgba(255, 255, 255, 0.02);
  "
>
  {links.map((link) => (
    <a
      href={link.href}
      class="dock-item group relative flex flex-col items-center justify-center gap-0.5 px-2 py-1.5 md:px-2.5 md:py-2 rounded-xl transition-all duration-200 ease-out min-w-[48px] md:min-w-[56px]"
      style="background: transparent; color: var(--text-secondary);"
      title={link.label}
    >
      <span class="w-5 h-5 md:w-6 md:h-6 flex items-center justify-center">
        {link.icon === 'home' && (
          <svg
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            viewBox="0 0 24 24"
          >
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
            <polyline points="9 22 9 12 15 12 15 22" />
          </svg>
        )}
        {link.icon === 'user' && (
          <svg
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            viewBox="0 0 24 24"
          >
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
            <circle cx="12" cy="7" r="4" />
          </svg>
        )}
        {link.icon === 'cpu' && (
          <svg
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            viewBox="0 0 24 24"
          >
            <rect x="4" y="4" width="16" height="16" rx="2" />
            <rect x="9" y="9" width="6" height="6" />
            <path d="M9 1v3M15 1v3M9 20v3M15 20v3M1 9h3M1 15h3M20 9h3M20 15h3" />
          </svg>
        )}
        {link.icon === 'award' && (
          <svg
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            viewBox="0 0 24 24"
          >
            <circle cx="12" cy="8" r="6" />
            <path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11" />
          </svg>
        )}
        {link.icon === 'server' && (
          <svg
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            viewBox="0 0 24 24"
          >
            <rect x="2" y="2" width="20" height="8" rx="2" />
            <rect x="2" y="14" width="20" height="8" rx="2" />
            <line x1="6" y1="6" x2="6.01" y2="6" />
            <line x1="6" y1="18" x2="6.01" y2="18" />
          </svg>
        )}
        {link.icon === 'folder' && (
          <svg
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            viewBox="0 0 24 24"
          >
            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" />
          </svg>
        )}
        {link.icon === 'mail' && (
          <svg
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            viewBox="0 0 24 24"
          >
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
            <polyline points="22,6 12,13 2,6" />
          </svg>
        )}
      </span>

      <span class="dock-label font-mono text-[9px] md:text-[10px] leading-none whitespace-nowrap opacity-60 group-hover:opacity-100 transition-opacity">
        {link.label}
      </span>
    </a>
  ))}
</nav>

<style>
  #mac-dock .dock-item {
    transition:
      transform 180ms cubic-bezier(0.2, 0.9, 0.3, 1.2),
      background-color 180ms ease,
      color 180ms ease;
    transform-origin: bottom center;
  }

  #mac-dock .dock-item:hover {
    transform: translateY(-6px) scale(1.12);
    background: var(--glass-bg) !important;
    color: var(--accent) !important;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: inset 0 1px 0 var(--glass-highlight);
  }

  @media (max-width: 768px) {
    #mac-dock .dock-item:hover {
      transform: translateY(-3px) scale(1.05);
    }
  }
</style>
