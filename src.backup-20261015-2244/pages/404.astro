---
import BaseLayout from '@layouts/BaseLayout.astro';
import Container from '@components/layout/Container.astro';
---

<BaseLayout title="404 — Page introuvable">
  <Container size="wide">
    <div class="py-32 text-center">
      <p class="font-mono text-sm mb-4" style="color: var(--text-muted);">
        404
      </p>
      <h1 class="text-3xl mb-6" style="color: var(--text-primary);">
        Page introuvable
      </h1>
      <a href="/" class="font-mono text-sm underline" style="color: var(--accent);">
        ← Retour à l'accueil
      </a>
    </div>
  </Container>
</BaseLayout>
