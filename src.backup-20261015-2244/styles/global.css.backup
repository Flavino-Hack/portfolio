/* ============================================
   STYLES GLOBAUX — Tailwind v4 + tokens + base
   ============================================ */

@import "tailwindcss";
@import "./tokens.css";

@layer base {
  html {
    background: var(--bg-primary);
    color: var(--text-primary);
    font-family: system-ui, -apple-system, sans-serif;
    transition: background 200ms ease, color 200ms ease;
    scroll-behavior: smooth;
  }

  body {
    min-height: 100vh;
    -webkit-font-smoothing: antialiased;
  }

  ::selection {
    background: var(--accent);
    color: var(--bg-primary);
  }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 4px;
  }

  /* Scrollbar fine (WebKit) */
  ::-webkit-scrollbar {
    width: 10px;
    height: 10px;
  }

  ::-webkit-scrollbar-track {
    background: transparent;
  }

  ::-webkit-scrollbar-thumb {
    background: var(--border-strong);
    border-radius: 5px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: var(--text-muted);
  }
}

/* ============================================
   TRANSITIONS HORIZONTALES ENTRE SECTIONS
   ============================================ */

/* Les sections sont masquées par défaut quand on n'est pas dessus */
.section-hidden {
  display: none;
}

.section-active {
  display: block;
  animation: slide-in-right 480ms cubic-bezier(0.2, 0.9, 0.3, 1);
}

.section-leaving {
  animation: slide-out-left 480ms cubic-bezier(0.2, 0.9, 0.3, 1) forwards;
}

@keyframes slide-in-right {
  from {
    opacity: 0;
    transform: translateX(40px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes slide-out-left {
  from {
    opacity: 1;
    transform: translateX(0);
  }
  to {
    opacity: 0;
    transform: translateX(-40px);
  }
}

/* Accessibilité : désactiver les animations si l'utilisateur préfère */
@media (prefers-reduced-motion: reduce) {
  .section-active,
  .section-leaving {
    animation: none;
  }
}
