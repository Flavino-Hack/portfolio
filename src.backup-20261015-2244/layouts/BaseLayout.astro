---
import '@/styles/global.css';
import Header from '@components/layout/Header.astro';
import Dock from '@components/layout/Dock.astro';
import Footer from '@components/layout/Footer.astro';
import Sound from '@components/ui/Sound.astro';

interface Props {
  title: string;
  description?: string;
  lang?: string;
}

const {
  title,
  description = 'Portfolio — Réseau, Développement, Cybersécurité',
  lang = 'fr',
} = Astro.props;
---

<!doctype html>
<html lang={lang} data-theme="ops">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <script is:inline>
      (function () {
        const saved = localStorage.getItem('theme');
        const system = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'ops' : 'audit';
        document.documentElement.dataset.theme = saved || system;
      })();
    </script>
  </head>

  <body>
    <Header />

    <main>
      <slot />
    </main>

    <Footer />
    <Dock />
    <Sound />

    <!-- Lightbox global pour afficher les photos en grand -->
    <div
      id="global-lightbox"
      class="fixed inset-0 z-[200] hidden items-center justify-center p-4"
      style="background: rgba(0, 0, 0, 0.85); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);"
    >
      <button
        type="button"
        id="lightbox-close"
        class="absolute top-6 right-6 w-10 h-10 rounded-full flex items-center justify-center text-white hover-lift"
        style="background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.2); cursor: pointer; font-size: 20px;"
        aria-label="Fermer"
      >
        ?
      </button>
      <img
        id="lightbox-img"
        src=""
        alt=""
        class="max-w-full max-h-[85vh] rounded-xl"
        style="box-shadow: 0 32px 80px rgba(0, 0, 0, 0.6);"
      />
    </div>

    <script is:inline>
      (function () {
        const lightbox = document.getElementById('global-lightbox');
        const lightboxImg = document.getElementById('lightbox-img');
        const closeBtn = document.getElementById('lightbox-close');
        if (!lightbox || !lightboxImg || !closeBtn) return;

        window.openLightbox = function (src, alt) {
          lightboxImg.src = src;
          lightboxImg.alt = alt || '';
          lightbox.classList.remove('hidden');
          lightbox.classList.add('flex');
        };

        function closeLightbox() {
          lightbox.classList.add('hidden');
          lightbox.classList.remove('flex');
          lightboxImg.src = '';
        }

        closeBtn.addEventListener('click', closeLightbox);
        lightbox.addEventListener('click', (e) => {
          if (e.target === lightbox) closeLightbox();
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !lightbox.classList.contains('hidden')) {
            closeLightbox();
          }
        });
      })();
    </script>
    <script is:inline>
      (function () {
        const sections = Array.from(document.querySelectorAll('.section'));
        if (sections.length === 0) return;

        // Si on n'est pas sur la home, on ne g�re pas les transitions
        const isHome = window.location.pathname === '/' || window.location.pathname === '/en/';
        if (!isHome) return;

        let currentSection = sections[0];

        sections.forEach((s) => {
          if (s === currentSection) {
            s.classList.add('section-active');
          } else {
            s.classList.add('section-hidden');
          }
        });

        function goToSection(target) {
          if (target === currentSection) return;

          const leaving = currentSection;
          const entering = target;

          entering.classList.remove('section-hidden');
          entering.classList.add('section-active');
          leaving.classList.add('section-leaving');

          setTimeout(() => {
            leaving.classList.remove('section-leaving', 'section-active');
            leaving.classList.add('section-hidden');
          }, 480);

          currentSection = entering;
          window.scrollTo({ top: 0, behavior: 'instant' });
        }

        document.addEventListener('click', function (e) {
          const link = e.target.closest('a[href^="#"], a[href^="\/#"]');
          if (!link) return;

          const rawHref = link.getAttribute('href');
          if (!rawHref) return;
          const href = rawHref.startsWith('/#') ? rawHref.slice(1) : rawHref;
          if (!href || href === '#') return;

          const target = document.querySelector(href);
          if (!target || !target.classList.contains('section')) return;

          e.preventDefault();
          goToSection(target);
        });

        if (window.location.hash) {
          const initial = document.querySelector(window.location.hash);
          if (initial && initial.classList.contains('section')) {
            goToSection(initial);
          }
        }
      })();
    </script>
  </body>
</html>
