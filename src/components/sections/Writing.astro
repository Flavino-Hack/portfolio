---
import Container from '@components/layout/Container.astro';
import { useTranslations, type Lang } from '@/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'fr' } = Astro.props;
const t = useTranslations(lang);
---

<section
  id="writing"
  data-section="writing"
  class="section min-h-screen flex items-center py-20 scroll-mt-16"
>
  <Container size="wide">
    <p class="font-mono text-xs mb-3" style="color: var(--text-muted);">
      08 — Writing
    </p>
    <h2
      class="text-3xl md:text-4xl font-bold tracking-tight leading-tight mb-4"
      style="color: var(--text-primary);"
    >
      Articles
      <br />& Write-ups
    </h2>
    <p class="text-sm" style="color: var(--text-secondary);">
      Coming soon...
    </p>
  </Container>
</section>
