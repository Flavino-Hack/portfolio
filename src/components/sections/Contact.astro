---
/**
 * Contact — formulaire + liens + CV.
 */
import Container from '@components/layout/Container.astro';

const contacts = [
  { label: 'GitHub', value: '@fhkdev', href: 'https://github.com/fhkdev', icon: 'github' },
  { label: 'LinkedIn', value: '/in/fhkdev', href: 'https://linkedin.com/in/fhkdev', icon: 'linkedin' },
  { label: 'Email', value: 'contact@fhkdev.dev', href: 'mailto:contact@fhkdev.dev', icon: 'mail' },
  { label: 'WhatsApp', value: '+226 XX XX XX XX', href: 'https://wa.me/22600000000', icon: 'phone' },
];
---

<section
  id="contact"
  data-section="contact"
  class="section min-h-screen flex items-center py-20 scroll-mt-16"
>
  <Container size="wide">
    <div class="grid md:grid-cols-12 gap-10 items-start">
      <!-- ───── Colonne gauche : titre + liens ───── -->
      <div class="md:col-span-5">
        <p class="font-mono text-xs mb-3" style="color: var(--text-muted);">07 — Contact</p>
        <h2
          class="text-3xl md:text-4xl font-bold tracking-tight leading-tight mb-4"
          style="color: var(--text-primary);"
        >
          Travaillons<br />ensemble
        </h2>
        <p class="text-sm mb-8 leading-relaxed" style="color: var(--text-secondary);">
          Un projet réseau, une app à développer, une infra à sécuriser ? Parlons-en.
        </p>

        <!-- Liens directs -->
        <div class="space-y-2 mb-8">
          {contacts.map((contact) => (
            <a
              href={contact.href}
              target="_blank"
              rel="noopener"
              class="flex items-center gap-3 p-3 rounded-lg border glass transition-transform hover:-translate-y-0.5"
              style="border-color: var(--glass-border);"
            >
              <span
                class="w-9 h-9 rounded-lg flex items-center justify-center shrink-0"
                style="background: var(--glass-bg); color: var(--accent); border: 1px solid var(--glass-border);"
              >
                {contact.icon === 'github' && (
                  <svg fill="currentColor" viewBox="0 0 24 24" class="w-4 h-4">
                    <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
                  </svg>
                )}
                {contact.icon === 'linkedin' && (
                  <svg fill="currentColor" viewBox="0 0 24 24" class="w-4 h-4">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                  </svg>
                )}
                {contact.icon === 'mail' && (
                  <svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" class="w-4 h-4">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                    <polyline points="22,6 12,13 2,6" />
                  </svg>
                )}
                {contact.icon === 'phone' && (
                  <svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" class="w-4 h-4">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
                  </svg>
                )}
              </span>
              <div class="min-w-0">
                <p class="font-mono text-[10px]" style="color: var(--text-muted);">{contact.label}</p>
                <p class="text-sm truncate" style="color: var(--text-primary);">{contact.value}</p>
              </div>
            </a>
          ))}
        </div>

        <!-- CV -->
        <a
          href="/cv.pdf"
          download
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg border glass font-mono text-xs hover-lift"
          style="border-color: var(--glass-border); color: var(--text-primary);"
        >
          <svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" class="w-3.5 h-3.5">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="7 10 12 15 17 10" />
            <line x1="12" y1="15" x2="12" y2="3" />
          </svg>
          Télécharger mon CV
        </a>
      </div>

      <!-- ───── Colonne droite : formulaire ───── -->
      <div class="md:col-span-7">
        <form
          class="p-6 rounded-xl border glass space-y-4"
          style="border-color: var(--glass-border);"
          action="https://formspree.io/f/xxxxxxx"
          method="POST"
        >
          <div class="grid md:grid-cols-2 gap-4">
            <div>
              <label
                for="name"
                class="block font-mono text-[11px] mb-2"
                style="color: var(--text-muted);"
              >
                Nom
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full px-3 py-2.5 rounded-lg border text-sm"
                style="
                  border-color: var(--glass-border);
                  background: var(--glass-bg);
                  color: var(--text-primary);
                  outline: none;
                "
                placeholder="Votre nom"
              />
            </div>
            <div>
              <label
                for="email"
                class="block font-mono text-[11px] mb-2"
                style="color: var(--text-muted);"
              >
                Email
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-3 py-2.5 rounded-lg border text-sm"
                style="
                  border-color: var(--glass-border);
                  background: var(--glass-bg);
                  color: var(--text-primary);
                  outline: none;
                "
                placeholder="vous@exemple.com"
              />
            </div>
          </div>

          <div>
            <label
              for="subject"
              class="block font-mono text-[11px] mb-2"
              style="color: var(--text-muted);"
            >
              Sujet
            </label>
            <input
              type="text"
              id="subject"
              name="subject"
              class="w-full px-3 py-2.5 rounded-lg border text-sm"
              style="
                border-color: var(--glass-border);
                background: var(--glass-bg);
                color: var(--text-primary);
                outline: none;
              "
              placeholder="Réseau, dev, sécu..."
            />
          </div>

          <div>
            <label
              for="message"
              class="block font-mono text-[11px] mb-2"
              style="color: var(--text-muted);"
            >
              Message
            </label>
            <textarea
              id="message"
              name="message"
              required
              rows="5"
              class="w-full px-3 py-2.5 rounded-lg border text-sm resize-none"
              style="
                border-color: var(--glass-border);
                background: var(--glass-bg);
                color: var(--text-primary);
                outline: none;
              "
              placeholder="Décrivez votre projet..."
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full inline-flex items-center justify-center gap-2 px-5 py-3 rounded-lg font-mono text-sm font-medium hover-lift-sm"
            style="background: var(--accent); color: var(--bg-primary);"
          >
            Envoyer le message
            <span>→</span>
          </button>

          <p class="font-mono text-[10px] text-center" style="color: var(--text-muted);">
            // Réponse sous 24h
          </p>
        </form>
      </div>
    </div>
  </Container>
</section>
