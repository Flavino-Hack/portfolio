---
import Container from '@components/layout/Container.astro';
import { useTranslations, type Lang } from '@/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'fr' } = Astro.props;
const t = useTranslations(lang);

const stages = [
  {
    id: 'moov-cnmo',
    key: 'cnmo',
    status: 'done' as const,
    tags: ['Fibre optique', 'Backbone', 'Monitoring', 'NOC', 'OTDR'],
  },
  {
    id: 'moov-ctr',
    key: 'ctr',
    status: 'done' as const,
    tags: ['BTS', 'Radio', 'NOC', 'Transmission', 'Monitoring'],
  },
  {
    id: 'future',
    key: 'future',
    status: 'future' as const,
    tags: ['Réseau', 'Système', 'DevOps', 'Sécurité', 'Dev'],
  },
];
---

<section
  id="stages"
  data-section="stages"
  class="section min-h-screen flex items-center py-20 scroll-mt-16"
>
  <Container size="wide">
    <div class="grid md:grid-cols-12 gap-10 items-start">
      <div class="md:col-span-4">
        <p class="font-mono text-xs mb-3" style="color: var(--text-muted);">
          {t.stages.label}
        </p>
        <h2
          class="text-3xl md:text-4xl font-bold tracking-tight leading-tight mb-4"
          style="color: var(--text-primary);"
          set:html={t.stages.title}
        />
        <p class="text-sm leading-relaxed" style="color: var(--text-secondary);">
          {t.stages.subtitle}
        </p>
      </div>

      <div class="md:col-span-8">
        <div class="timeline">
          {stages.map((stage, index) => {
            const data = t.stages.list[stage.key];
            return (
              <div class="timeline-item">
                <div class="timeline-marker">
                  <span
                    class="timeline-dot"
                    style={
                      stage.status === 'future'
                        ? 'background: var(--bg-elevated); border-color: var(--mac-yellow);'
                        : ''
                    }
                  ></span>
                  {index < stages.length - 1 && <span class="timeline-line"></span>}
                </div>
                <div class="timeline-content">
                  <div class="flex flex-wrap items-baseline justify-between gap-3 mb-2">
                    <h3 class="text-lg font-semibold" style="color: var(--text-primary);">
                      Moov Africa
                      {stage.status === 'future' && (
                        <span
                          class="ml-2 font-mono text-[10px] px-2 py-0.5 rounded-md align-middle"
                          style="background: var(--glass-bg); color: var(--mac-yellow); border: 1px solid var(--glass-border);"
                        >
                          {t.stages.statusFuture}
                        </span>
                      )}
                    </h3>
                    <span class="font-mono text-[11px]" style="color: var(--text-muted);">
                      {data.duration}
                    </span>
                  </div>
                  <p class="font-mono text-[12px] mb-1" style="color: var(--accent);">
                    {data.role}
                  </p>
                  <p class="font-mono text-[10px] mb-4" style="color: var(--text-muted);">
                    {data.location}
                  </p>
                  <p class="text-sm leading-relaxed mb-4" style="color: var(--text-secondary);">
                    {data.summary}
                  </p>
                  <div class="flex flex-wrap gap-1.5 mb-4">
                    {stage.tags.slice(0, 4).map((tag) => (
                      <span
                        class="font-mono text-[10px] px-2 py-0.5 rounded border"
                        style="border-color: var(--glass-border); background: var(--glass-bg); color: var(--text-muted);"
                      >
                        {tag}
                      </span>
                    ))}
                  </div>
                  <details class="mt-2">
                    <summary
                      class="cursor-pointer font-mono text-[11px] inline-flex items-center gap-2 px-3 py-1.5 rounded-md border glass"
                      style="color: var(--text-primary); border-color: var(--glass-border);"
                    >
                      {stage.status === 'future' ? t.stages.contactMe : t.stages.viewDetail}
                    </summary>
                    <div
                      class="mt-3 p-4 rounded-lg border"
                      style="border-color: var(--glass-border); background: var(--glass-bg);"
                    >
                      <p class="text-sm mb-3" style="color: var(--text-secondary);">
                        {data.description}
                      </p>
                      <p
                        class="font-mono text-[10px] uppercase tracking-wider mb-2"
                        style="color: var(--text-muted);"
                      >
                        {t.stages.missions}
                      </p>
                      <ul class="space-y-1.5">
                        {data.missions.map((m) => (
                          <li
                            class="flex items-start gap-2 text-[13px]"
                            style="color: var(--text-secondary);"
                          >
                            <span
                              class="font-mono text-[10px] mt-0.5 shrink-0"
                              style="color: var(--accent);"
                            >
                              ▸
                            </span>
                            <span>{m}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </details>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </Container>
</section>

<style>
  .timeline-item {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 20px;
    padding-bottom: 40px;
  }
  .timeline-item:last-child {
    padding-bottom: 0;
  }
  .timeline-marker {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 6px;
  }
  .timeline-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--accent);
    border: 3px solid var(--bg-primary);
    box-shadow: 0 0 0 1px var(--accent);
    flex-shrink: 0;
  }
  .timeline-line {
    flex: 1;
    width: 2px;
    background: var(--border-strong);
    margin-top: 8px;
    margin-bottom: -16px;
    opacity: 0.5;
  }
  @media (max-width: 640px) {
    .timeline-item {
      grid-template-columns: 24px 1fr;
      gap: 12px;
    }
  }
</style>
