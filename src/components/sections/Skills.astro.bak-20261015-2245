---
import Container from '@components/layout/Container.astro';
import { useTranslations, type Lang } from '@/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'fr' } = Astro.props;
const t = useTranslations(lang);

const categories = [
  {
    key: 'network',
    title: t.skills.networkTitle,
    skills: [
      { key: 'tcp', icon: '🌐', color: '#0a84ff' },
      { key: 'firewall', icon: '🛡️', color: '#ff453a' },
      { key: 'windows', icon: '🪟', color: '#00a4ef' },
      { key: 'linux', icon: '🐧', color: '#e95420' },
      { key: 'virtualization', icon: '📦', color: '#e57000' },
      { key: 'vpn', icon: '🔐', color: '#88171a' },
      { key: 'monitoring', icon: '📊', color: '#f46800' },
      { key: 'security', icon: '🔍', color: '#5e5ce6' },
    ],
  },
  {
    key: 'dev',
    title: t.skills.devTitle,
    skills: [
      { key: 'languages', icon: '🐍', color: '#3776ab' },
      { key: 'frameworks', icon: '⚛️', color: '#61dafb' },
      { key: 'databases', icon: '🗄️', color: '#336791' },
      { key: 'api', icon: '🔌', color: '#22c55e' },
      { key: 'git', icon: '🐙', color: '#f05033' },
      { key: 'docker', icon: '🐳', color: '#2496ed' },
      { key: 'bash', icon: '⌨️', color: '#4eaa25' },
      { key: 'tests', icon: '🧪', color: '#00c853' },
    ],
  },
];
---

<section
  id="skills"
  data-section="skills"
  class="section min-h-screen flex items-center py-20 scroll-mt-16"
>
  <Container size="wide">
    <div class="grid md:grid-cols-12 gap-8 items-start">
      <div class="md:col-span-4">
        <p class="font-mono text-xs mb-3" style="color: var(--text-muted);">
          {t.skills.label}
        </p>
        <h2
          class="text-3xl md:text-4xl font-bold tracking-tight leading-tight mb-4"
          style="color: var(--text-primary);"
          set:html={t.skills.title}
        />
        <p class="text-sm leading-relaxed" style="color: var(--text-secondary);">
          {t.skills.subtitle}
        </p>
      </div>

      <div class="md:col-span-8 grid md:grid-cols-2 gap-6">
        {categories.map((cat) => (
          <div class="p-5 rounded-xl border glass" style="border-color: var(--glass-border);">
            <p
              class="font-mono text-[10px] uppercase tracking-wider mb-4"
              style="color: var(--text-muted);"
            >
              {cat.title}
            </p>
            <ul class="space-y-3">
              {cat.skills.map((skill) => {
                const data = t.skills.skillsList[cat.key][skill.key];
                const level = 80;
                const bars = 10;
                const filled = Math.round((level / 100) * bars);
                return (
                  <li class="pb-3 border-b" style="border-color: var(--border-subtle);">
                    <div class="flex items-center gap-2 mb-1">
                      <span class="text-base">{skill.icon}</span>
                      <span class="text-sm font-medium" style="color: var(--text-primary);">
                        {data.label}
                      </span>
                    </div>
                    <p
                      class="text-[12px] leading-relaxed mb-2"
                      style="color: var(--text-secondary);"
                    >
                      {data.desc}
                    </p>
                    <div class="flex flex-wrap gap-1">
                      {data.tags.map((tag) => (
                        <span
                          class="font-mono text-[9px] px-1.5 py-0.5 rounded border"
                          style=`border-color: ${skill.color}55; background: ${skill.color}11; color: ${skill.color};`
                        >
                          {tag}
                        </span>
                      ))}
                    </div>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </Container>
</section>
