---
/**
 * Stages — expériences professionnelles (stages, alternances, missions).
 */
import Container from '@components/layout/Container.astro';

const stages = [
  {
    company: 'TechCorp Solutions',
    role: 'Stagiaire Administrateur Réseau',
    duration: 'Juin — Août 2024 · 3 mois',
    location: 'Ouagadougou, Burkina Faso',
    missions: [
      'Refonte du réseau interne : segmentation en 4 VLAN',
      'Mise en place d\'un VPN WireGuard pour 15 télétravailleurs',
      'Supervision Zabbix de 25 serveurs et équipements',
    ],
    tags: ['pfSense', 'WireGuard', 'Zabbix', 'VLAN'],
  },
  {
    company: 'DataFlow Agency',
    role: 'Développeur Full-Stack (stage)',
    duration: 'Janvier — Avril 2024 · 4 mois',
    location: 'Remote',
    missions: [
      'Développement d\'une API REST pour une app de gestion client',
      'Intégration d\'un dashboard temps réel avec WebSockets',
      'Mise en place de la CI/CD (GitHub Actions + Docker)',
    ],
    tags: ['TypeScript', 'Node.js', 'PostgreSQL', 'Docker'],
  },
  {
    company: 'SecureNet Consulting',
    role: 'Assistant Sécurité Réseau',
    duration: 'Juillet — Septembre 2023 · 2 mois',
    location: 'Ouagadougou, Burkina Faso',
    missions: [
      'Audit de sécurité de 3 réseaux PME',
      'Rédaction de rapports de vulnérabilités',
      'Durcissement de configurations pfSense et Linux',
    ],
    tags: ['Kali', 'Nmap', 'pfSense', 'Hardening'],
  },
];
---

<section
  id="stages"
  data-section="stages"
  class="section min-h-screen flex items-center py-20 scroll-mt-16"
>
  <Container size="wide">
    <div class="grid md:grid-cols-12 gap-10 items-start">
      <!-- Colonne gauche : titre -->
      <div class="md:col-span-4">
        <p class="font-mono text-xs mb-3" style="color: var(--text-muted);">03 — Stages</p>
        <h2
          class="text-3xl md:text-4xl font-bold tracking-tight leading-tight mb-4"
          style="color: var(--text-primary);"
        >
          Expériences<br />professionnelles
        </h2>
        <p class="text-sm leading-relaxed" style="color: var(--text-secondary);">
          Stages, alternances et missions qui m'ont formé au terrain.
        </p>
      </div>

      <!-- Colonne droite : liste des stages -->
      <div class="md:col-span-8 space-y-4">
        {stages.map((stage) => (
          <div class="p-5 rounded-xl border glass hover-lift" style="border-color: var(--glass-border);">
            <!-- Header : entreprise + durée -->
            <div class="flex flex-wrap items-start justify-between gap-3 mb-3">
              <div class="flex items-start gap-3 min-w-0">
                <div
                  class="w-10 h-10 rounded-lg flex items-center justify-center shrink-0"
                  style="background: var(--glass-bg); color: var(--accent); border: 1px solid var(--glass-border);"
                >
                  <svg fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" class="w-5 h-5">
                    <rect x="2" y="7" width="20" height="14" rx="2" />
                    <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" />
                  </svg>
                </div>
                <div class="min-w-0">
                  <h3 class="font-semibold text-base leading-tight" style="color: var(--text-primary);">
                    {stage.company}
                  </h3>
                  <p class="font-mono text-[11px]" style="color: var(--accent);">
                    {stage.role}
                  </p>
                </div>
              </div>

              <div class="text-right shrink-0">
                <p class="font-mono text-[10px]" style="color: var(--text-muted);">
                  {stage.duration}
                </p>
                <p class="font-mono text-[10px]" style="color: var(--text-muted);">
                  {stage.location}
                </p>
              </div>
            </div>

            <!-- Missions -->
            <ul class="space-y-1.5 mb-4 pl-1">
              {stage.missions.map((mission) => (
                <li class="flex items-start gap-2 text-sm" style="color: var(--text-secondary);">
                  <span class="font-mono text-[10px] mt-1 shrink-0" style="color: var(--text-muted);">▸</span>
                  <span>{mission}</span>
                </li>
              ))}
            </ul>

            <!-- Tags -->
            <div class="flex flex-wrap gap-1.5">
              {stage.tags.map((tag) => (
                <span
                  class="font-mono text-[10px] px-2 py-0.5 rounded border hover-tag"
                  style="
                    border-color: var(--glass-border);
                    background: var(--glass-bg);
                    color: var(--text-muted);
                  "
                >
                  {tag}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </Container>
</section>
