---
interface Props {
  name: string;
  size?: number;
}

const { name, size = 48 } = Astro.props;
---

<span
  class="tech-icon"
  style={'width: ' + size + 'px; height: ' + size + 'px; display: inline-block;'}
>
  {name === 'ubuntu' && (
    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:100%">
      <circle cx="12" cy="12" r="11" fill="#E95420" />
      <circle cx="12" cy="12" r="6" fill="none" stroke="#fff" stroke-width="1.5" />
      <circle cx="12" cy="6" r="1.5" fill="#fff" />
      <circle cx="7" cy="15" r="1.5" fill="#fff" />
      <circle cx="17" cy="15" r="1.5" fill="#fff" />
    </svg>
  )}
  {name === 'docker' && (
    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:100%">
      <rect x="2" y="12" width="3" height="3" fill="#2496ED" />
      <rect x="6" y="12" width="3" height="3" fill="#2496ED" />
      <rect x="10" y="12" width="3" height="3" fill="#2496ED" />
      <rect x="14" y="12" width="3" height="3" fill="#2496ED" />
      <rect x="6" y="8" width="3" height="3" fill="#2496ED" />
      <rect x="10" y="8" width="3" height="3" fill="#2496ED" />
      <rect x="14" y="8" width="3" height="3" fill="#2496ED" />
      <path d="M2 16h18c0 3-2 5-5 5H7c-3 0-5-2-5-5z" fill="#2496ED" />
    </svg>
  )}
  {name === 'python' && (
    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:100%">
      <path
        d="M12 2c-3 0-5 1-5 3v2h5v1H5c-2 0-3 2-3 4s1 4 3 4h2v-2c0-2 2-4 4-4h4c2 0 3-1 3-3V5c0-2-2-3-6-3z"
        fill="#3776AB"
      />
      <path
        d="M12 22c3 0 5-1 5-3v-2h-5v-1h7c2 0 3-2 3-4s-1-4-3-4h-2v2c0 2-2 4-4 4h-4c-2 0-3 1-3 3v4c0 2 2 3 6 3z"
        fill="#FFD43B"
      />
    </svg>
  )}
  {name === 'nodejs' && (
    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:100%">
      <path d="M12 2L3 7v10l9 5 9-5V7l-9-5zm0 2.5l7 4v1l-7 4-7-4v-1l7-4z" fill="#339933" />
    </svg>
  )}
  {name === 'git' && (
    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:100%">
      <path
        d="M23.5 11L13 .5C12.4-.1 11.6-.1 11 .5L8.7 2.8l2.8 2.8c.6-.2 1.4-.1 1.9.4.5.5.7 1.3.4 2l2.7 2.7c.6-.2 1.4-.1 1.9.4.7.7.7 1.9 0 2.6s-1.9.7-2.6 0c-.5-.5-.7-1.3-.4-2l-2.5-2.5v6.5c.2.1.3.2.5.3.7.7.7 1.9 0 2.6-.7.7-1.9.7-2.6 0-.7-.7-.7-1.9 0-2.6.2-.2.4-.3.6-.4V9c-.2-.1-.4-.2-.6-.4-.5-.5-.7-1.3-.4-2L7.6 3.8.5 11c-.6.6-.6 1.6 0 2.2L11 23.5c.6.6 1.6.6 2.2 0L23.5 13.2c.6-.6.6-1.6 0-2.2z"
        fill="#F05032"
      />
    </svg>
  )}
  {name === 'postgres' && (
    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:100%">
      <circle cx="12" cy="12" r="11" fill="#336791" />
      <ellipse cx="12" cy="7" rx="5" ry="2" fill="none" stroke="#fff" stroke-width="1" />
      <path d="M7 7v8c0 2 2 4 5 4s5-2 5-4V7" fill="none" stroke="#fff" stroke-width="1" />
      <circle cx="12" cy="18" r="1" fill="#fff" />
    </svg>
  )}
  {name === 'bash' && (
    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:100%">
      <rect
        x="2"
        y="4"
        width="20"
        height="16"
        rx="2"
        fill="#2b2b2b"
        stroke="#4EAA25"
        stroke-width="1.5"
      />
      <text x="6" y="15" fill="#4EAA25" font-family="monospace" font-size="8" font-weight="bold">
        $_
      </text>
    </svg>
  )}
  {name === 'zabbix' && (
    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:100%">
      <circle cx="12" cy="12" r="11" fill="#D40000" />
      <path d="M7 6h10l-6 6h6v6H7l6-6H7V6z" fill="#fff" />
    </svg>
  )}
  {name === 'pfsense' && (
    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:100%">
      <circle cx="12" cy="12" r="11" fill="#FF5C00" />
      <path
        d="M8 8h5c1.7 0 3 1.3 3 3s-1.3 3-3 3h-3v3H8V8zm2 2v2h3c.6 0 1-.4 1-1s-.4-1-1-1h-3z"
        fill="#fff"
      />
    </svg>
  )}
  {name === 'grafana' && (
    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:100%">
      <circle cx="12" cy="12" r="11" fill="#F46800" />
      <circle cx="12" cy="12" r="6" fill="none" stroke="#fff" stroke-width="1.5" />
      <circle cx="12" cy="12" r="2" fill="#fff" />
    </svg>
  )}
  {name === 'kali' && (
    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:100%">
      <circle cx="12" cy="12" r="11" fill="#557C94" />
      <path d="M7 6h3l3 6-2 6H8l3-6-4-6z" fill="#fff" />
    </svg>
  )}
  {name === 'wireshark' && (
    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:100%">
      <circle cx="12" cy="12" r="11" fill="#1679A7" />
      <path
        d="M4 12c2-4 4-6 8-6s6 2 8 6c-2 4-4 6-8 6s-6-2-8-6z"
        fill="none"
        stroke="#fff"
        stroke-width="1.2"
      />
    </svg>
  )}
  {name === 'windows' && (
    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:100%">
      <rect x="3" y="3" width="8" height="8" fill="#00a4ef" />
      <rect x="13" y="3" width="8" height="8" fill="#00a4ef" />
      <rect x="3" y="13" width="8" height="8" fill="#00a4ef" />
      <rect x="13" y="13" width="8" height="8" fill="#00a4ef" />
    </svg>
  )}
  {name === 'linux' && (
    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:100%">
      <circle cx="12" cy="12" r="11" fill="#000" />
      <ellipse cx="12" cy="13" rx="4" ry="6" fill="#fff" />
      <circle cx="10" cy="11" r="1" fill="#000" />
      <circle cx="14" cy="11" r="1" fill="#000" />
    </svg>
  )}
  {name === 'flutter' && (
    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:100%">
      <path d="M14.314 0L2.3 12 6 15.7 21.684 0H14.314z" fill="#42A5F5" />
      <path
        d="M14.314 14.7L9.35 19.6 14.314 24.7 21.684 24.7 16.72 19.6 21.684 14.7z"
        fill="#42A5F5"
      />
      <path d="M9.35 19.6l2.484-2.45L9.35 14.7 6 18 9.35 19.6z" fill="#0D47A1" />
    </svg>
  )}
  {name === 'default' && (
    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:100%">
      <circle cx="12" cy="12" r="11" fill="#58a6ff" opacity="0.6" />
      <text x="12" y="16" text-anchor="middle" fill="#fff" font-family="monospace" font-size="10">
        &lt;/&gt;
      </text>
    </svg>
  )}
</span>

<style>
  .tech-icon {
    display: inline-block;
  }
  .tech-icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
