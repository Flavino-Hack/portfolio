---
/**
 * Terminal — style Oh My Zsh / Powerlevel10k.
 * Prompt riche : pomme + user + machine + chemin + git + statut + heure.
 */
---

<div
  id="mac-terminal-wrapper"
  class="relative w-full"
>
  <div
    id="mac-terminal"
    class="absolute top-0 left-0 w-full rounded-xl border overflow-hidden select-none"
    style="
      background: var(--bg-surface);
      border-color: var(--glass-border);
      box-shadow:
        var(--shadow-lg),
        inset 0 1px 0 var(--glass-highlight);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      z-index: 10;
    "
  >
    <!-- Title bar (drag handle) -->
    <div
      id="terminal-titlebar"
      class="flex items-center gap-2 px-3 py-2 border-b cursor-grab active:cursor-grabbing"
      style="border-color: var(--border-subtle); background: var(--bg-elevated);"
      title="Glisser pour déplacer · Double-clic pour recentrer"
    >
      <span class="w-3 h-3 rounded-full" style="background: var(--mac-red);"></span>
      <span class="w-3 h-3 rounded-full" style="background: var(--mac-yellow);"></span>
      <span class="w-3 h-3 rounded-full" style="background: var(--mac-green);"></span>
      <p class="flex-1 text-center font-mono text-[11px] pointer-events-none" style="color: var(--text-muted);">
        fhkdev@portfolio — zsh
      </p>
      <span class="w-[42px]"></span>
    </div>

    <!-- Corps -->
    <div
      id="terminal-output"
      class="p-4 font-mono text-xs leading-relaxed h-[360px] overflow-y-auto"
      style="color: var(--text-secondary);"
    ></div>

    <!-- Input -->
    <div
      class="flex items-center gap-2 px-4 py-3 border-t"
      style="border-color: var(--border-subtle); background: var(--bg-elevated);"
    >
      <span class="prompt-left font-mono text-xs shrink-0" id="active-prompt"></span>
      <input
        id="terminal-input"
        type="text"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        class="flex-1 bg-transparent border-none outline-none font-mono text-xs"
        style="color: var(--text-primary);"
        placeholder=""
      />
      <span
        id="active-time"
        class="font-mono text-[10px] tabular-nums shrink-0"
        style="color: var(--text-muted);"
      ></span>
    </div>
  </div>
</div>

<div class="w-full" style="height: 460px;" aria-hidden="true"></div>

<script>
  (function () {
    const output = document.getElementById('terminal-output');
    const input = document.getElementById('terminal-input') as HTMLInputElement | null;
    const win = document.getElementById('mac-terminal');
    const titlebar = document.getElementById('terminal-titlebar');
    const activePrompt = document.getElementById('active-prompt');
    const activeTime = document.getElementById('active-time');
    if (!output || !input || !win || !titlebar || !activePrompt || !activeTime) return;

    // ─────────────────────────────────────────
    // CONFIG
    // ─────────────────────────────────────────
    const isMac = /mac|iphone|ipad/i.test(navigator.platform || navigator.userAgent);
    const APPLE = isMac ? '\uF8FF' : '>';
    const USER = 'fhkdev';
    const HOST = 'portfolio';
    const CWD = '~';

    let gitStatus: 'clean' | 'dirty' | 'error' = 'clean';

    // ─────────────────────────────────────────
    // PROMPT RENDERER
    // ─────────────────────────────────────────
    function promptHTML(status: 'clean' | 'dirty' | 'error' = gitStatus): string {
      const statusColor =
        status === 'clean' ? '#7ee787' : status === 'dirty' ? '#febc2e' : '#ff5f57';
      const statusIcon = status === 'clean' ? '✓' : status === 'dirty' ? '⚠' : '✖';

      const branch = 'master';
      return `
        <span style="color: var(--text-secondary);">[</span>
        <span style="color: #ffffff;">${APPLE}</span>
        <span style="color: #7ee787;">${USER}</span>
        <span style="color: var(--text-muted);"> at </span>
        <span style="color: #ff9f0a;">${HOST}</span>
        <span style="color: var(--text-muted);"> in </span>
        <span style="color: #febc2e;">📁 ${CWD}</span>
        <span style="color: #bf5af2;"> ${branch}</span>
        <span style="color: ${statusColor};"> ${statusIcon}</span>
      `;
    }

    function nowString(): string {
      const d = new Date();
      const h = String(d.getHours()).padStart(2, '0');
      const m = String(d.getMinutes()).padStart(2, '0');
      const s = String(d.getSeconds()).padStart(2, '0');
      return `🕐 ${h}:${m}:${s}`;
    }

    // ─────────────────────────────────────────
    // DRAG
    // ─────────────────────────────────────────
    let isDragging = false;
    let startX = 0;
    let startY = 0;
    let offsetX = 0;
    let offsetY = 0;
    let currentLeft = 0;
    let currentTop = 0;

    function clamp(val: number, min: number, max: number) {
      return Math.max(min, Math.min(max, val));
    }

    titlebar.addEventListener('mousedown', (e) => {
      const target = e.target as HTMLElement;
      if (target.tagName === 'BUTTON') return;
      if (window.innerWidth < 768) return;

      isDragging = true;
      win!.style.transition = 'none';
      document.body.style.userSelect = 'none';
      startX = e.clientX;
      startY = e.clientY;
      offsetX = currentLeft;
      offsetY = currentTop;
      e.preventDefault();
    });

    document.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      const dx = e.clientX - startX;
      const dy = e.clientY - startY;
      currentLeft = clamp(offsetX + dx, -400, 400);
      currentTop = clamp(offsetY + dy, -200, 400);
      win!.style.left = `${currentLeft}px`;
      win!.style.top = `${currentTop}px`;
      win!.style.transform = 'none';
    });

    document.addEventListener('mouseup', () => {
      if (!isDragging) return;
      isDragging = false;
      win!.style.transition = 'box-shadow 200ms ease';
      document.body.style.userSelect = '';
    });

    titlebar.addEventListener('dblclick', () => {
      currentLeft = 0;
      currentTop = 0;
      win!.style.transition =
        'left 300ms cubic-bezier(0.2, 0.9, 0.3, 1), top 300ms cubic-bezier(0.2, 0.9, 0.3, 1)';
      win!.style.left = '0px';
      win!.style.top = '0px';
      setTimeout(() => {
        win!.style.transition = '';
      }, 320);
    });

    // ─────────────────────────────────────────
    // OUTPUT WRITERS
    // ─────────────────────────────────────────
    function writeHTML(html: string) {
      const line = document.createElement('div');
      line.innerHTML = html;
      line.style.whiteSpace = 'pre-wrap';
      output!.appendChild(line);
      output!.scrollTop = output!.scrollHeight;
    }

    function write(text: string, color = 'var(--text-secondary)') {
      writeHTML(`<span style="color: ${color};">${text}</span>`);
    }

    function writePromptLine(cmd: string, status: 'clean' | 'dirty' | 'error' = 'clean') {
      const html = `
        <div style="display:flex; justify-content:space-between; gap:1rem;">
          <span>${promptHTML(status)}</span>
          <span style="color: var(--text-muted); flex-shrink:0;">${nowString()}</span>
        </div>
        <div style="margin-top: 2px;">
          <span style="color: var(--text-muted);">$ </span>
          <span style="color: var(--text-primary);">${cmd}</span>
        </div>
      `;
      const wrap = document.createElement('div');
      wrap.innerHTML = html;
      wrap.style.whiteSpace = 'pre-wrap';
      wrap.style.marginBottom = '6px';
      output!.appendChild(wrap);
      output!.scrollTop = output!.scrollHeight;
    }

    function blank() {
      write('');
    }

    // ─────────────────────────────────────────
    // COMMANDES
    // ─────────────────────────────────────────
    const commands: Record<string, () => void> = {
      help: () => {
        write('Commandes disponibles :', '#e6edf3');
        write('  whoami      → qui je suis');
        write('  skills      → mes compétences');
        write('  projects    → mes projets');
        write('  contact     → comment me joindre');
        write('  ls          → fichiers du portfolio');
        write('  git status  → statut git');
        write('  cat about   → bio courte');
        write('  clear       → effacer');
      },
      whoami: () => {
        write('KIEMA Wendtoin Guy Flavien', '#e6edf3');
        write('alias : fhkdev');
        write('rôle  : Administrateur Réseau & Développeur Full-Stack');
      },
      skills: () => {
        write('Réseau / Système :', '#e6edf3');
        write('  ▸ TCP/IP, VLAN, Routage', '#7ee787');
        write('  ▸ pfSense, MikroTik', '#7ee787');
        write('  ▸ Linux (Ubuntu, Debian)', '#7ee787');
        write('  ▸ Proxmox, VMware', '#7ee787');
        write('  ▸ Zabbix, Grafana', '#7ee787');
        blank();
        write('Développement :', '#e6edf3');
        write('  ▸ Python, TypeScript, JavaScript', '#58a6ff');
        write('  ▸ Node.js, Astro', '#58a6ff');
        write('  ▸ PostgreSQL, MySQL', '#58a6ff');
        write('  ▸ Docker, Git', '#58a6ff');
      },
      projects: () => {
        write('Projets récents :', '#e6edf3');
        write('  ▸ Réseau d\'entreprise segmenté en VLAN', '#febc2e');
        write('  ▸ Application de gestion de parc', '#febc2e');
        write('  ▸ Monitoring réseau avec alertes Telegram', '#febc2e');
        blank();
        write('→ Scrollez vers la section Projets', '#58a6ff');
      },
      contact: () => {
        write('Me contacter :', '#e6edf3');
        write('  email    : contact@fhkdev.dev', '#7ee787');
        write('  github   : github.com/fhkdev', '#7ee787');
        write('  linkedin : linkedin.com/in/fhkdev', '#7ee787');
      },
      ls: () => {
        write('📁 projects/', '#58a6ff');
        write('📁 lab/', '#58a6ff');
        write('📁 skills/', '#58a6ff');
        write('📄 about.md', '#e6edf3');
        write('📄 cv.pdf', '#e6edf3');
        write('🐍 monitoring.py', '#7ee787');
        write('📜 vlan-config.sh', '#febc2e');
        write('📜 deploy.sh', '#febc2e');
      },
      clear: () => {
        output!.innerHTML = '';
      },
    };

    function run(raw: string) {
      const cmd = raw.trim();
      if (!cmd) return;

      writePromptLine(cmd, gitStatus);

      // git status : commande spéciale
      if (cmd === 'git status') {
        write('On branch master', '#e6edf3');
        write('nothing to commit, working tree clean', '#7ee787');
        return;
      }

      if (cmd === 'cat about') {
        write('Je conçois, sécurise et automatise des infrastructures réseau.', 'var(--text-secondary)');
        write(
          "Du câble au code — des systèmes que n'importe qui peut reprendre.",
          'var(--text-secondary)'
        );
        return;
      }

      const fn = commands[cmd];
      if (fn) {
        fn();
      } else {
        gitStatus = 'error';
        write(`zsh: command not found: ${cmd}`, '#ff5f57');
        write(`Tapez 'help' pour la liste des commandes.`, 'var(--text-muted)');
        // Reset après un délai
        setTimeout(() => {
          gitStatus = 'clean';
          updateActivePrompt();
        }, 2500);
      }
    }

    function updateActivePrompt() {
      activePrompt!.innerHTML = promptHTML(gitStatus);
      activeTime!.textContent = nowString();
    }

    // ─────────────────────────────────────────
    // INPUT
    // ─────────────────────────────────────────
    const history: string[] = [];
    let historyIndex = -1;

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        const value = input.value;
        if (value.trim()) {
          history.unshift(value);
          historyIndex = -1;
        }
        run(value);
        input.value = '';
        updateActivePrompt();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (historyIndex < history.length - 1) {
          historyIndex++;
          input.value = history[historyIndex] ?? '';
        }
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (historyIndex > 0) {
          historyIndex--;
          input.value = history[historyIndex] ?? '';
        } else {
          historyIndex = -1;
          input.value = '';
        }
      }
    });

    // ─────────────────────────────────────────
    // INIT
    // ─────────────────────────────────────────
    write('Bienvenue dans le terminal de fhkdev.', '#e6edf3');
    write("Tapez 'help' pour voir les commandes disponibles.");
    blank();

    updateActivePrompt();
    setInterval(updateActivePrompt, 1000);

    // Animation de frappe d'un whoami au chargement
    const auto = 'whoami';
    let i = 0;
    const type = () => {
      if (i <= auto.length) {
        input.value = auto.slice(0, i);
        i++;
        setTimeout(type, 90);
      } else {
        setTimeout(() => {
          run(auto);
          input.value = '';
          updateActivePrompt();
        }, 400);
      }
    };
    setTimeout(type, 600);

    // Focus au clic
    win.addEventListener('click', () => input.focus());
  })();
</script>
