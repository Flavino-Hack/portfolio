---
/**
 * Sound — son "Taptic" style Apple (roue de sélection iOS).
 * Toc grave, très court, discret.
 */
---

<script>
  (function () {
    const STORAGE_KEY = 'fhkdev-sound';
    const MIN_INTERVAL = 60;
    let audioCtx: AudioContext | null = null;
    let soundEnabled = localStorage.getItem(STORAGE_KEY) !== 'off';
    let audioUnlocked = false;
    let lastPlay = 0;

    function initAudio() {
      if (audioCtx) return;
      try {
        audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
      } catch {
        audioCtx = null;
      }
    }

    function unlockAudio() {
      if (audioUnlocked) return;
      initAudio();
      if (audioCtx && audioCtx.state === 'suspended') {
        audioCtx.resume();
      }
      audioUnlocked = true;
      document.removeEventListener('click', unlockAudio);
      document.removeEventListener('keydown', unlockAudio);
    }

    document.addEventListener('click', unlockAudio);
    document.addEventListener('keydown', unlockAudio);

    // ─────────────────────────────────────
    // LE SON "TOC" (Taptic style)
    // ─────────────────────────────────────
    function playTaptic() {
      if (!soundEnabled || !audioUnlocked || !audioCtx) return;

      const now = performance.now();
      if (now - lastPlay < MIN_INTERVAL) return;
      lastPlay = now;

      try {
        const t = audioCtx.currentTime;

        // Oscillateur triangle très grave (le "corps" du son)
        const osc = audioCtx.createOscillator();
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(220, t);
        osc.frequency.exponentialRampToValueAtTime(120, t + 0.025);

        // Gain (enveloppe courte)
        const gain = audioCtx.createGain();
        gain.gain.setValueAtTime(0, t);
        gain.gain.linearRampToValueAtTime(0.18, t + 0.002);
        gain.gain.exponentialRampToValueAtTime(0.0001, t + 0.035);

        // Filtre passe-bas pour adoucir
        const filter = audioCtx.createBiquadFilter();
        filter.type = 'lowpass';
        filter.frequency.value = 800;
        filter.Q.value = 0.7;

        osc.connect(filter);
        filter.connect(gain);
        gain.connect(audioCtx.destination);

        osc.start(t);
        osc.stop(t + 0.04);

        // Petite "queue" haute très discrète (pour la sensation de feedback)
        const osc2 = audioCtx.createOscillator();
        osc2.type = 'sine';
        osc2.frequency.setValueAtTime(1400, t);
        osc2.frequency.exponentialRampToValueAtTime(600, t + 0.01);

        const gain2 = audioCtx.createGain();
        gain2.gain.setValueAtTime(0, t);
        gain2.gain.linearRampToValueAtTime(0.03, t + 0.001);
        gain2.gain.exponentialRampToValueAtTime(0.0001, t + 0.012);

        osc2.connect(gain2);
        gain2.connect(audioCtx.destination);

        osc2.start(t);
        osc2.stop(t + 0.015);
      } catch {
        // Silencieux
      }
    }

    // ─────────────────────────────────────
    // DÉCLENCHEMENT AU SURVOL
    // ─────────────────────────────────────
    const SELECTOR = '.hover-lift, .dock-item, .menu-item, .menu-trigger, .hover-tag';

    document.addEventListener(
      'mouseover',
      (e) => {
        const target = e.target as HTMLElement | null;
        if (!target) return;
        const el = target.closest(SELECTOR);
        if (!el) return;

        const related = e.relatedTarget as HTMLElement | null;
        if (related && el.contains(related)) return;

        playTaptic();
      },
      true,
    );

    // ─────────────────────────────────────
    // BOUTON MUTE
    // ─────────────────────────────────────
    function updateMuteButtons() {
      document.querySelectorAll('[data-sound-toggle]').forEach((btn) => {
        const el = btn as HTMLElement;
        el.setAttribute('aria-label', soundEnabled ? 'Désactiver le son' : 'Activer le son');
        el.dataset.soundState = soundEnabled ? 'on' : 'off';
        el.innerHTML = soundEnabled
          ? `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" /><path d="M15.54 8.46a5 5 0 0 1 0 7.07" /><path d="M19.07 4.93a10 10 0 0 1 0 14.14" /></svg>`
          : `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" /><line x1="23" y1="9" x2="17" y2="15" /><line x1="17" y1="9" x2="23" y2="15" /></svg>`;
      });
    }

    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement | null)?.closest('[data-sound-toggle]');
      if (!btn) return;

      soundEnabled = !soundEnabled;
      localStorage.setItem(STORAGE_KEY, soundEnabled ? 'on' : 'off');
      updateMuteButtons();

      if (soundEnabled) {
        unlockAudio();
        playTaptic();
      }
    });

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', updateMuteButtons);
    } else {
      updateMuteButtons();
    }
  })();
</script>
