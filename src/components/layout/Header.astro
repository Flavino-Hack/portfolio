---
import ThemeToggle from './ThemeToggle.astro';
---

<header
  class="sticky top-0 z-50 border-b"
  style="
    border-color: var(--glass-border);
    background: var(--glass-bg);
    backdrop-filter: blur(28px) saturate(200%);
    -webkit-backdrop-filter: blur(28px) saturate(200%);
    box-shadow: inset 0 -1px 0 var(--glass-highlight);
  "
>
  <div class="flex items-center justify-between h-11 px-4 md:px-5 gap-3">
    <!-- GAUCHE -->
    <div class="flex items-center gap-4 min-w-0">
      <!-- 3 pastilles cliquables -->
      <a
        href="/"
        class="flex items-center gap-2 shrink-0 cursor-pointer px-1.5 py-1 rounded-md transition-colors"
        title="Retour à l'accueil"
        aria-label="Retour à l'accueil"
        onmouseover="this.style.background='var(--glass-bg)'"
        onmouseout="this.style.background='transparent'"
      >
        <span class="w-[11px] h-[11px] rounded-full" style="background: var(--mac-red);"></span>
        <span class="w-[11px] h-[11px] rounded-full" style="background: var(--mac-yellow);"></span>
        <span class="w-[11px] h-[11px] rounded-full" style="background: var(--mac-green);"></span>
      </a>

      <span class="hidden md:block w-px h-3.5" style="background: var(--border-subtle);"></span>

      <!-- fhkdev cliquable -->
      <a
        href="/"
        class="font-mono text-[12px] font-semibold shrink-0 tracking-tight px-1.5 py-1 rounded-md transition-colors"
        style="color: var(--text-primary); text-decoration: none;"
        onmouseover="this.style.background='var(--glass-bg)'"
        onmouseout="this.style.background='transparent'"
      >
        fhkdev
      </a>

      <!-- MENUS Fichier / Édition / Affichage -->
      <nav class="hidden lg:flex items-center gap-0.5 ml-1" id="main-menus">
        <!-- Fichier -->
        <div class="menu-wrapper relative">
          <button
            type="button"
            class="menu-trigger font-mono text-[12px] select-none px-2.5 py-1 rounded cursor-pointer transition-colors"
            style="color: var(--text-secondary); background: transparent; border: none;"
          >
            Fichier
          </button>
          <div
            class="menu-dropdown absolute top-full left-0 mt-1 min-w-[220px] py-1.5 rounded-lg border hidden z-[60]"
            style="
              background: var(--bg-elevated);
              border-color: var(--glass-border);
              box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35), inset 0 1px 0 var(--glass-highlight);
              backdrop-filter: blur(24px);
              -webkit-backdrop-filter: blur(24px);
            "
          >
            <a
              href="/cv.pdf"
              download
              class="menu-item flex items-center justify-between gap-6 px-3 py-1.5 text-[12px]"
              style="color: var(--text-primary); text-decoration: none;"
            >
              <span>📄 Télécharger mon CV</span>
              <span class="font-mono text-[10px]" style="color: var(--text-muted);">
                ⌘D
              </span>
            </a>
            <a
              href="https://github.com/Flavino-Hack"
              target="_blank"
              rel="noopener"
              class="menu-item flex items-center justify-between gap-6 px-3 py-1.5 text-[12px]"
              style="color: var(--text-primary); text-decoration: none;"
            >
              <span>💻 Voir mon GitHub</span>
              <span class="font-mono text-[10px]" style="color: var(--text-muted);">
                ⌘G
              </span>
            </a>
            <a
              href="/#contact"
              class="menu-item flex items-center justify-between gap-6 px-3 py-1.5 text-[12px]"
              style="color: var(--text-primary); text-decoration: none;"
            >
              <span>✉️ Me contacter</span>
              <span class="font-mono text-[10px]" style="color: var(--text-muted);">
                ⌘C
              </span>
            </a>
          </div>
        </div>

        <!-- Édition -->
        <div class="menu-wrapper relative">
          <button
            type="button"
            class="menu-trigger font-mono text-[12px] select-none px-2.5 py-1 rounded cursor-pointer transition-colors"
            style="color: var(--text-secondary); background: transparent; border: none;"
          >
            Édition
          </button>
          <div
            class="menu-dropdown absolute top-full left-0 mt-1 min-w-[220px] py-1.5 rounded-lg border hidden z-[60]"
            style="
              background: var(--bg-elevated);
              border-color: var(--glass-border);
              box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35), inset 0 1px 0 var(--glass-highlight);
              backdrop-filter: blur(24px);
              -webkit-backdrop-filter: blur(24px);
            "
          >
            <button
              type="button"
              data-action="toggle-theme"
              class="menu-item w-full text-left flex items-center justify-between gap-6 px-3 py-1.5 text-[12px] cursor-pointer"
              style="color: var(--text-primary); background: transparent; border: none;"
            >
              <span>🌙 Basculer le thème</span>
              <span class="font-mono text-[10px]" style="color: var(--text-muted);">
                ⌘T
              </span>
            </button>
            <button
              type="button"
              data-action="copy-email"
              class="menu-item w-full text-left flex items-center justify-between gap-6 px-3 py-1.5 text-[12px] cursor-pointer"
              style="color: var(--text-primary); background: transparent; border: none;"
            >
              <span>📋 Copier mon email</span>
              <span class="font-mono text-[10px]" style="color: var(--text-muted);">
                ⌘E
              </span>
            </button>
          </div>
        </div>

        <!-- Affichage -->
        <div class="menu-wrapper relative">
          <button
            type="button"
            class="menu-trigger font-mono text-[12px] select-none px-2.5 py-1 rounded cursor-pointer transition-colors"
            style="color: var(--text-secondary); background: transparent; border: none;"
          >
            Affichage
          </button>
          <div
            class="menu-dropdown absolute top-full left-0 mt-1 min-w-[220px] py-1.5 rounded-lg border hidden z-[60]"
            style="
              background: var(--bg-elevated);
              border-color: var(--glass-border);
              box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35), inset 0 1px 0 var(--glass-highlight);
              backdrop-filter: blur(24px);
              -webkit-backdrop-filter: blur(24px);
            "
          >
            <a
              href="/#hero"
              class="menu-item flex items-center justify-between gap-6 px-3 py-1.5 text-[12px]"
              style="color: var(--text-primary); text-decoration: none;"
            >
              <span>🏠 Accueil</span>
              <span class="font-mono text-[10px]" style="color: var(--text-muted);">
                ⌘1
              </span>
            </a>
            <a
              href="/#profil"
              class="menu-item flex items-center justify-between gap-6 px-3 py-1.5 text-[12px]"
              style="color: var(--text-primary); text-decoration: none;"
            >
              <span>👤 Profil</span>
              <span class="font-mono text-[10px]" style="color: var(--text-muted);">
                ⌘2
              </span>
            </a>
            <a
              href="/#skills"
              class="menu-item flex items-center justify-between gap-6 px-3 py-1.5 text-[12px]"
              style="color: var(--text-primary); text-decoration: none;"
            >
              <span>⚙️ Compétences</span>
              <span class="font-mono text-[10px]" style="color: var(--text-muted);">
                ⌘3
              </span>
            </a>
            <a
              href="/#stages"
              class="menu-item flex items-center justify-between gap-6 px-3 py-1.5 text-[12px]"
              style="color: var(--text-primary); text-decoration: none;"
            >
              <span>💼 Stages</span>
              <span class="font-mono text-[10px]" style="color: var(--text-muted);">
                ⌘4
              </span>
            </a>
            <a
              href="/#certifs"
              class="menu-item flex items-center justify-between gap-6 px-3 py-1.5 text-[12px]"
              style="color: var(--text-primary); text-decoration: none;"
            >
              <span>🏆 Certifications</span>
              <span class="font-mono text-[10px]" style="color: var(--text-muted);">
                ⌘5
              </span>
            </a>
            <a
              href="/#lab"
              class="menu-item flex items-center justify-between gap-6 px-3 py-1.5 text-[12px]"
              style="color: var(--text-primary); text-decoration: none;"
            >
              <span>🖥️ Lab perso</span>
              <span class="font-mono text-[10px]" style="color: var(--text-muted);">
                ⌘6
              </span>
            </a>
            <a
              href="/#projets"
              class="menu-item flex items-center justify-between gap-6 px-3 py-1.5 text-[12px]"
              style="color: var(--text-primary); text-decoration: none;"
            >
              <span>📁 Projets</span>
              <span class="font-mono text-[10px]" style="color: var(--text-muted);">
                ⌘7
              </span>
            </a>
            <a
              href="/#contact"
              class="menu-item flex items-center justify-between gap-6 px-3 py-1.5 text-[12px]"
              style="color: var(--text-primary); text-decoration: none;"
            >
              <span>✉️ Contact</span>
              <span class="font-mono text-[10px]" style="color: var(--text-muted);">
                ⌘8
              </span>
            </a>
          </div>
        </div>
      </nav>
    </div>

    <!-- DROITE -->
    <div class="flex items-center gap-2 shrink-0">
      <div
        id="net-widget"
        class="hidden md:flex items-center rounded-md px-1.5 py-1 cursor-default"
        style="color: var(--text-secondary);"
        title="Trafic réseau"
      >
        <canvas id="net-canvas" width="80" height="18" class="net-canvas"></canvas>
      </div>

      <svg
        class="hidden md:block wifi-icon rounded-md cursor-default"
        width="16"
        height="16"
        viewBox="0 0 16 16"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        style="color: var(--text-secondary);"
      >
        <path
          d="M2 6.5C3.7 5 5.8 4.2 8 4.2C10.2 4.2 12.3 5 14 6.5"
          stroke="currentColor"
          stroke-width="1.2"
          stroke-linecap="round"
        />
        <path
          d="M4 9C5.1 8 6.5 7.5 8 7.5C9.5 7.5 10.9 8 12 9"
          stroke="currentColor"
          stroke-width="1.2"
          stroke-linecap="round"
        />
        <path
          d="M6 11.2C6.6 10.7 7.3 10.5 8 10.5C8.7 10.5 9.4 10.7 10 11.2"
          stroke="currentColor"
          stroke-width="1.2"
          stroke-linecap="round"
        />
        <circle cx="8" cy="13.2" r="0.9" fill="currentColor" />
      </svg>

      <div
        id="battery-widget"
        class="hidden md:flex items-center gap-1.5 px-1.5 py-1 rounded-md cursor-default"
        title="Batterie"
        style="color: var(--text-secondary);"
      >
        <span id="battery-percent" class="font-mono text-[11px] tabular-nums">
          87%
        </span>
        <svg
          id="battery-icon"
          width="24"
          height="11"
          viewBox="0 0 24 11"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          style="color: var(--text-secondary);"
        >
          <rect
            x="0.5"
            y="1.5"
            width="20"
            height="8"
            rx="2.5"
            stroke="currentColor"
            stroke-width="1"
          />
          <rect x="22" y="4" width="1.5" height="3" rx="0.5" fill="currentColor" opacity="0.6" />
          <rect
            id="battery-fill"
            x="2.5"
            y="3.5"
            width="17.4"
            height="4"
            rx="1"
            fill="currentColor"
          />
        </svg>
      </div>

      <button
        id="palette-trigger"
        type="button"
        aria-label="Recherche"
        class="hidden md:flex items-center justify-center w-7 h-7 rounded-md cursor-pointer transition-colors"
        style="color: var(--text-secondary); background: transparent; border: none;"
        title="Recherche (Ctrl+K)"
        onmouseover="this.style.background='var(--glass-bg)'"
        onmouseout="this.style.background='transparent'"
      >
        <svg
          width="15"
          height="15"
          viewBox="0 0 15 15"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <circle cx="6.5" cy="6.5" r="4.5" stroke="currentColor" stroke-width="1.2" />
          <path
            d="M10 10L13.5 13.5"
            stroke="currentColor"
            stroke-width="1.2"
            stroke-linecap="round"
          />
        </svg>
      </button>

      <button
        type="button"
        data-sound-toggle
        aria-label="Son"
        class="hidden md:flex items-center justify-center w-7 h-7 rounded-md cursor-pointer transition-colors"
        style="color: var(--text-secondary); background: transparent; border: none;"
        title="Son au survol"
        onmouseover="this.style.background='var(--glass-bg)'"
        onmouseout="this.style.background='transparent'"
      ></button>

      <span
        class="hidden md:block w-px h-3.5 mx-1"
        style="background: var(--border-subtle);"
      ></span>

      <span
        id="mac-clock"
        class="font-mono text-[12px] tabular-nums tracking-tight cursor-default px-2 py-1 rounded-md"
        style="color: var(--text-secondary);"
        title="Survolez pour les secondes"
      >
        --:--
      </span>

      <div
        class="lang-switcher flex items-center gap-0.5 rounded-md overflow-hidden"
        style="border: 1px solid var(--border-subtle);"
      >
        <a
          href="/"
          class="lang-btn font-mono text-[10px] px-2 py-1"
          data-lang="fr"
          style="color: var(--text-secondary); text-decoration: none;"
        >
          FR
        </a>
        <a
          href="/en/"
          class="lang-btn font-mono text-[10px] px-2 py-1"
          data-lang="en"
          style="color: var(--text-secondary); text-decoration: none;"
        >
          EN
        </a>
      </div>

      <ThemeToggle />
    </div>
  </div>
</header>

<!-- COMMAND PALETTE -->
<div
  id="palette-backdrop"
  class="fixed inset-0 z-[100] hidden items-start justify-center pt-[15vh]"
  style="background: rgba(0, 0, 0, 0.5); backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px);"
>
  <div
    id="palette-panel"
    class="w-full max-w-lg mx-4 rounded-2xl border overflow-hidden"
    style="background: var(--bg-surface); border-color: var(--glass-border); box-shadow: var(--shadow-lg), inset 0 1px 0 var(--glass-highlight);"
  >
    <div
      class="flex items-center gap-3 px-4 py-3 border-b"
      style="border-color: var(--border-subtle);"
    >
      <svg width="16" height="16" viewBox="0 0 15 15" fill="none" style="color: var(--text-muted);">
        <circle cx="6.5" cy="6.5" r="4.5" stroke="currentColor" stroke-width="1.2" />
        <path
          d="M10 10L13.5 13.5"
          stroke="currentColor"
          stroke-width="1.2"
          stroke-linecap="round"
        />
      </svg>
      <input
        id="palette-input"
        type="text"
        placeholder="Rechercher..."
        autocomplete="off"
        class="flex-1 bg-transparent border-none outline-none font-mono text-sm"
        style="color: var(--text-primary);"
      />
      <kbd
        class="font-mono text-[10px] px-1.5 py-0.5 rounded border"
        style="color: var(--text-muted); border-color: var(--border-subtle);"
      >
        ESC
      </kbd>
    </div>
    <div id="palette-results" class="max-h-80 overflow-y-auto py-2"></div>
  </div>
</div>

<!-- TOAST -->
<div
  id="toast"
  class="fixed bottom-24 left-1/2 -translate-x-1/2 z-[110] hidden px-4 py-2 rounded-lg border font-mono text-xs"
  style="background: var(--bg-elevated); border-color: var(--glass-border); color: var(--text-primary); box-shadow: 0 8px 24px rgba(0,0,0,0.3); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);"
></div>

<script>
  // 1. MENUS
  (function menus() {
    const wrappers = document.querySelectorAll('.menu-wrapper');
    function closeAll(except?: Element) {
      wrappers.forEach((w) => {
        if (w !== except) {
          w.querySelector('.menu-dropdown')?.classList.add('hidden');
        }
      });
    }
    wrappers.forEach((w) => {
      const trigger = w.querySelector('.menu-trigger');
      const dropdown = w.querySelector('.menu-dropdown');
      if (!trigger || !dropdown) return;
      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        const isHidden = dropdown.classList.contains('hidden');
        closeAll(w);
        if (isHidden) dropdown.classList.remove('hidden');
        else dropdown.classList.add('hidden');
      });
      dropdown.querySelectorAll('.menu-item').forEach((item) => {
        item.addEventListener('click', () => dropdown.classList.add('hidden'));
      });
    });
    document.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('.menu-wrapper')) closeAll();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeAll();
    });
  })();

  // 2. ACTIONS
  (function menuActions() {
    document.querySelectorAll('[data-action="toggle-theme"]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const current = document.documentElement.dataset.theme;
        const next = current === 'ops' ? 'audit' : 'ops';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('theme', next);
      });
    });
    document.querySelectorAll('[data-action="copy-email"]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText('flavien.kiema@flavino-hack-dev.kdns.fr');
          const toast = document.getElementById('toast');
          if (toast) {
            toast.textContent = 'Email copié !';
            toast.classList.remove('hidden');
            setTimeout(() => toast.classList.add('hidden'), 2200);
          }
        } catch {}
      });
    });
  })();

  // 3. BATTERIE
  (function battery() {
    let level = 87;
    const percentEl = document.getElementById('battery-percent');
    const fillEl = document.getElementById('battery-fill') as SVGRectElement | null;
    const iconEl = document.getElementById('battery-icon');
    if (!percentEl || !fillEl) return;
    function render() {
      if (!percentEl || !fillEl) return;
      percentEl.textContent = `${level}%`;
      const width = (level / 100) * 17.4;
      fillEl.setAttribute('width', String(Math.max(0, width)));
      if (level <= 5) {
        fillEl.setAttribute('fill', 'var(--mac-red)');
        iconEl?.classList.add('battery-critical');
      } else if (level <= 20) {
        fillEl.setAttribute('fill', 'var(--mac-yellow)');
        iconEl?.classList.remove('battery-critical');
      } else {
        fillEl.setAttribute('fill', 'currentColor');
        iconEl?.classList.remove('battery-critical');
      }
    }
    render();
    setInterval(() => {
      level = Math.max(5, level - 1);
      render();
    }, 20000);
  })();

  // 4. HORLOGE
  (function clock() {
    const el = document.getElementById('mac-clock');
    if (!el) return;
    let hovering = false;
    el.addEventListener('mouseenter', () => (hovering = true));
    el.addEventListener('mouseleave', () => (hovering = false));
    const days = ['dim.', 'lun.', 'mar.', 'mer.', 'jeu.', 'ven.', 'sam.'];
    function render() {
      const now = new Date();
      const day = days[now.getDay()] ?? '';
      const h = String(now.getHours()).padStart(2, '0');
      const m = String(now.getMinutes()).padStart(2, '0');
      if (hovering) {
        const s = String(now.getSeconds()).padStart(2, '0');
        el!.textContent = `${day} ${h}:${m}:${s}`;
      } else {
        el!.textContent = `${day} ${h}:${m}`;
      }
    }
    render();
    setInterval(render, 1000);
  })();

  // 5. FLUX RÉSEAU
  (function networkMeter() {
    const canvas = document.getElementById('net-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const COUNT = 26,
      UPDATE = 700,
      BAR_W = 2,
      GAP = 1;
    const down: number[] = new Array(COUNT).fill(0);
    const up: number[] = new Array(COUNT).fill(0);
    function next(prev: number, isUp: boolean): number {
      const base = isUp ? 15 : 55;
      const v = isUp ? 30 : 130;
      return Math.max(0, prev * 0.55 + (base + (Math.random() - 0.5) * v) * 0.45);
    }
    function draw() {
      const w = canvas!.width,
        h = canvas!.height;
      const max = Math.max(...down, ...up, 1);
      ctx!.clearRect(0, 0, w, h);
      down.forEach((v, i) => {
        const bh = Math.max(1, (v / max) * (h - 2));
        ctx!.fillStyle = '#58a6ff';
        ctx!.globalAlpha = 0.4 + (i / down.length) * 0.6;
        ctx!.fillRect(i * (BAR_W + GAP), h - bh, BAR_W, bh);
      });
      up.forEach((v, i) => {
        const bh = Math.max(1, (v / max) * (h - 2)) * 0.6;
        ctx!.fillStyle = '#7ee787';
        ctx!.globalAlpha = 0.35 + (i / up.length) * 0.5;
        ctx!.fillRect(i * (BAR_W + GAP), 0, BAR_W, bh);
      });
      ctx!.globalAlpha = 1;
    }
    function tick() {
      down.push(next(down[down.length - 1] ?? 0, false));
      up.push(next(up[up.length - 1] ?? 0, true));
      if (down.length > COUNT) down.shift();
      if (up.length > COUNT) up.shift();
      draw();
    }
    tick();
    setInterval(tick, UPDATE);
  })();

  // 6. COMMAND PALETTE
  (function palette() {
    const backdrop = document.getElementById('palette-backdrop');
    const input = document.getElementById('palette-input') as HTMLInputElement | null;
    const results = document.getElementById('palette-results');
    const trigger = document.getElementById('palette-trigger');
    if (!backdrop || !input || !results) return;
    const items = [
      { label: 'Accueil', href: '/#hero', category: 'Section' },
      { label: 'Profil', href: '/#profil', category: 'Section' },
      { label: 'Compétences', href: '/#skills', category: 'Section' },
      { label: 'Stages', href: '/#stages', category: 'Section' },
      { label: 'Certifications', href: '/#certifs', category: 'Section' },
      { label: 'Lab', href: '/#lab', category: 'Section' },
      { label: 'Projets', href: '/#projets', category: 'Section' },
      { label: 'Contact', href: '/#contact', category: 'Section' },
      {
        label: 'GitHub',
        href: 'https://github.com/Flavino-Hack',
        category: 'Lien',
        external: true,
      },
      {
        label: 'LinkedIn',
        href: 'https://www.linkedin.com/in/flavienkiema',
        category: 'Lien',
        external: true,
      },
      {
        label: 'Email',
        href: 'mailto:flavien.kiema@flavino-hack-dev.kdns.fr',
        category: 'Lien',
        external: true,
      },
      { label: 'CV', href: '/cv.pdf', category: 'Action', external: true },
    ];
    let filtered = [...items],
      selected = 0;
    function render() {
      results!.innerHTML = '';
      if (filtered.length === 0) {
        const e = document.createElement('div');
        e.className = 'px-4 py-8 text-center font-mono text-xs';
        e.style.color = 'var(--text-muted)';
        e.textContent = 'Aucun résultat';
        results!.appendChild(e);
        return;
      }
      filtered.forEach((item, i) => {
        const el = document.createElement('a');
        el.href = item.href;
        if (item.external) {
          el.target = '_blank';
          el.rel = 'noopener';
        }
        el.className =
          'flex items-center justify-between px-4 py-2.5 cursor-pointer transition-colors';
        el.style.color = 'var(--text-primary)';
        el.style.background = i === selected ? 'var(--glass-bg)' : 'transparent';
        el.innerHTML = `<span class="text-sm">${item.label}</span><span class="font-mono text-[10px]" style="color: var(--text-muted);">${item.category}</span>`;
        el.addEventListener('mouseenter', () => {
          selected = i;
          render();
        });
        el.addEventListener('click', close);
        results!.appendChild(el);
      });
    }
    function open() {
      backdrop!.classList.remove('hidden');
      backdrop!.classList.add('flex');
      input!.value = '';
      filtered = [...items];
      selected = 0;
      render();
      input!.focus();
    }
    function close() {
      backdrop!.classList.add('hidden');
      backdrop!.classList.remove('flex');
    }
    input.addEventListener('input', () => {
      const q = input.value.toLowerCase().trim();
      filtered = q ? items.filter((it) => it.label.toLowerCase().includes(q)) : [...items];
      selected = 0;
      render();
    });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowDown') {
        e.preventDefault();
        selected = Math.min(filtered.length - 1, selected + 1);
        render();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        selected = Math.max(0, selected - 1);
        render();
      } else if (e.key === 'Enter') {
        const it = filtered[selected];
        if (it) {
          window.location.href = it.href;
          close();
        }
      }
    });
    backdrop.addEventListener('click', (e) => {
      if (e.target === backdrop) close();
    });
    trigger?.addEventListener('click', open);
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (backdrop.classList.contains('hidden')) open();
        else close();
      }
    });
  })();

  // 7. LANGUE ACTIVE
  (function langActive() {
    const path = window.location.pathname;
    const isEn = path.startsWith('/en/') || path === '/en';
    document.querySelectorAll('.lang-btn').forEach((btn) => {
      const lang = btn.getAttribute('data-lang');
      if ((lang === 'en' && isEn) || (lang === 'fr' && !isEn)) {
        btn.setAttribute('data-active', 'true');
      }
    });
  })();
</script>

