---
import ThemeToggle from './ThemeToggle.astro';
---

<header
  class="sticky top-0 z-50 border-b"
  style="
    border-color: var(--glass-border);
    background: var(--glass-bg);
    backdrop-filter: blur(28px) saturate(200%);
    -webkit-backdrop-filter: blur(28px) saturate(200%);
    box-shadow: inset 0 -1px 0 var(--glass-highlight);
  "
>
  <div class="flex items-center justify-between h-11 px-4 md:px-5 gap-3">
    <!-- GAUCHE -->
    <div class="flex items-center gap-4 min-w-0">
      <div class="flex items-center gap-2 shrink-0">
        <span class="w-[11px] h-[11px] rounded-full" style="background: var(--mac-red);"></span>
        <span class="w-[11px] h-[11px] rounded-full" style="background: var(--mac-yellow);"></span>
        <span class="w-[11px] h-[11px] rounded-full" style="background: var(--mac-green);"></span>
      </div>

      <span class="hidden md:block w-px h-3.5" style="background: var(--border-subtle);"></span>

      <span class="font-mono text-[12px] font-semibold shrink-0 tracking-tight" style="color: var(--text-primary);">
        fhkdev
      </span>

      <!-- MENUS FONCTIONNELS -->
      <nav class="hidden lg:flex items-center gap-0.5 ml-1" id="mac-menus">
        <!-- Fichier -->
        <div class="menu-wrapper relative" data-menu="fichier">
          <button
            type="button"
            class="menu-trigger hover-lift font-mono text-[12px] select-none px-2.5 py-1 rounded cursor-pointer"
            style="color: var(--text-secondary); background: transparent; border: none;"
          >
            Fichier
          </button>
          <div
            class="menu-dropdown absolute top-full left-0 mt-1 min-w-[220px] py-1.5 rounded-lg border hidden z-[60]"
            style="
              background: var(--bg-elevated);
              border-color: var(--glass-border);
              box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35), inset 0 1px 0 var(--glass-highlight);
              backdrop-filter: blur(24px);
              -webkit-backdrop-filter: blur(24px);
            "
          >
            <a href="/cv.pdf" download class="menu-item flex items-center justify-between gap-6 px-3 py-1.5 text-[12px]" style="color: var(--text-primary);">
              <span class="flex items-center gap-2">
                <span style="color: var(--text-muted);">📄</span> Télécharger mon CV
              </span>
              <span class="font-mono text-[10px]" style="color: var(--text-muted);">⌘D</span>
            </a>
            <a href="https://github.com/fhkdev" target="_blank" rel="noopener" class="menu-item flex items-center justify-between gap-6 px-3 py-1.5 text-[12px]" style="color: var(--text-primary);">
              <span class="flex items-center gap-2">
                <span style="color: var(--text-muted);">💻</span> Voir mon GitHub
              </span>
              <span class="font-mono text-[10px]" style="color: var(--text-muted);">⌘G</span>
            </a>
            <div class="h-px my-1 mx-2" style="background: var(--border-subtle);"></div>
            <a href="#contact" class="menu-item flex items-center justify-between gap-6 px-3 py-1.5 text-[12px]" style="color: var(--text-primary);">
              <span class="flex items-center gap-2">
                <span style="color: var(--text-muted);">✉️</span> Me contacter
              </span>
              <span class="font-mono text-[10px]" style="color: var(--text-muted);">⌘C</span>
            </a>
          </div>
        </div>

        <!-- Édition -->
        <div class="menu-wrapper relative" data-menu="edition">
          <button
            type="button"
            class="menu-trigger hover-lift font-mono text-[12px] select-none px-2.5 py-1 rounded cursor-pointer"
            style="color: var(--text-secondary); background: transparent; border: none;"
          >
            Édition
          </button>
          <div
            class="menu-dropdown absolute top-full left-0 mt-1 min-w-[220px] py-1.5 rounded-lg border hidden z-[60]"
            style="
              background: var(--bg-elevated);
              border-color: var(--glass-border);
              box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35), inset 0 1px 0 var(--glass-highlight);
              backdrop-filter: blur(24px);
              -webkit-backdrop-filter: blur(24px);
            "
          >
            <button type="button" data-action="toggle-theme" class="menu-item w-full text-left flex items-center justify-between gap-6 px-3 py-1.5 text-[12px]" style="color: var(--text-primary);">
              <span class="flex items-center gap-2">
                <span style="color: var(--text-muted);">🌙</span> Basculer le thème
              </span>
              <span class="font-mono text-[10px]" style="color: var(--text-muted);">⌘T</span>
            </button>
            <button type="button" data-action="copy-email" class="menu-item w-full text-left flex items-center justify-between gap-6 px-3 py-1.5 text-[12px]" style="color: var(--text-primary);">
              <span class="flex items-center gap-2">
                <span style="color: var(--text-muted);">📋</span> Copier mon email
              </span>
              <span class="font-mono text-[10px]" style="color: var(--text-muted);">⌘E</span>
            </button>
          </div>
        </div>

        <!-- Affichage -->
        <div class="menu-wrapper relative" data-menu="affichage">
          <button
            type="button"
            class="menu-trigger hover-lift font-mono text-[12px] select-none px-2.5 py-1 rounded cursor-pointer"
            style="color: var(--text-secondary); background: transparent; border: none;"
          >
            Affichage
          </button>
          <div
            class="menu-dropdown absolute top-full left-0 mt-1 min-w-[220px] py-1.5 rounded-lg border hidden z-[60]"
            style="
              background: var(--bg-elevated);
              border-color: var(--glass-border);
              box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35), inset 0 1px 0 var(--glass-highlight);
              backdrop-filter: blur(24px);
              -webkit-backdrop-filter: blur(24px);
            "
          >
            <a href="#hero" class="menu-item flex items-center justify-between gap-6 px-3 py-1.5 text-[12px]" style="color: var(--text-primary);">
              <span class="flex items-center gap-2"><span style="color: var(--text-muted);">🏠</span> Accueil</span>
              <span class="font-mono text-[10px]" style="color: var(--text-muted);">⌘1</span>
            </a>
            <a href="#profil" class="menu-item flex items-center justify-between gap-6 px-3 py-1.5 text-[12px]" style="color: var(--text-primary);">
              <span class="flex items-center gap-2"><span style="color: var(--text-muted);">👤</span> Profil</span>
              <span class="font-mono text-[10px]" style="color: var(--text-muted);">⌘2</span>
            </a>
            <a href="#skills" class="menu-item flex items-center justify-between gap-6 px-3 py-1.5 text-[12px]" style="color: var(--text-primary);">
              <span class="flex items-center gap-2"><span style="color: var(--text-muted);">⚙️</span> Compétences</span>
              <span class="font-mono text-[10px]" style="color: var(--text-muted);">⌘3</span>
            </a>
            <a href="#stages" class="menu-item flex items-center justify-between gap-6 px-3 py-1.5 text-[12px]" style="color: var(--text-primary);">
              <span class="flex items-center gap-2"><span style="color: var(--text-muted);">💼</span> Stages</span>
              <span class="font-mono text-[10px]" style="color: var(--text-muted);">⌘4</span>
            </a>
            <a href="#certifs" class="menu-item flex items-center justify-between gap-6 px-3 py-1.5 text-[12px]" style="color: var(--text-primary);">
              <span class="flex items-center gap-2"><span style="color: var(--text-muted);">🏆</span> Certifications</span>
              <span class="font-mono text-[10px]" style="color: var(--text-muted);">⌘5</span>
            </a>
            <a href="#lab" class="menu-item flex items-center justify-between gap-6 px-3 py-1.5 text-[12px]" style="color: var(--text-primary);">
              <span class="flex items-center gap-2"><span style="color: var(--text-muted);">🖥️</span> Lab perso</span>
              <span class="font-mono text-[10px]" style="color: var(--text-muted);">⌘6</span>
            </a>
            <a href="#projets" class="menu-item flex items-center justify-between gap-6 px-3 py-1.5 text-[12px]" style="color: var(--text-primary);">
              <span class="flex items-center gap-2"><span style="color: var(--text-muted);">📁</span> Projets</span>
              <span class="font-mono text-[10px]" style="color: var(--text-muted);">⌘7</span>
            </a>
            <a href="#contact" class="menu-item flex items-center justify-between gap-6 px-3 py-1.5 text-[12px]" style="color: var(--text-primary);">
              <span class="flex items-center gap-2"><span style="color: var(--text-muted);">✉️</span> Contact</span>
              <span class="font-mono text-[10px]" style="color: var(--text-muted);">⌘8</span>
            </a>
          </div>
        </div>
      </nav>
    </div>

    <!-- DROITE -->
    <div class="flex items-center gap-1 shrink-0">
      <!-- Batterie -->
      <div
        id="battery-widget"
        class="hidden md:flex items-center gap-1.5 hover-lift px-1.5 py-1 rounded-md cursor-default"
        title="Batterie"
        style="color: var(--text-secondary);"
      >
        <span id="battery-percent" class="font-mono text-[11px] tabular-nums">87%</span>
        <svg id="battery-icon" width="24" height="11" viewBox="0 0 24 11" fill="none" xmlns="http://www.w3.org/2000/svg" style="color: var(--text-secondary);">
          <rect x="0.5" y="1.5" width="20" height="8" rx="2.5" stroke="currentColor" stroke-width="1" />
          <rect x="22" y="4" width="1.5" height="3" rx="0.5" fill="currentColor" opacity="0.6" />
          <rect id="battery-fill" x="2.5" y="3.5" width="17.4" height="4" rx="1" fill="currentColor" />
        </svg>
      </div>

      <!-- Wi-Fi -->
      <svg
        class="hidden md:block wifi-icon hover-lift rounded-md cursor-default"
        width="16"
        height="16"
        viewBox="0 0 16 16"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        style="color: var(--text-secondary);"
        title="Wi-Fi"
      >
        <path d="M2 6.5C3.7 5 5.8 4.2 8 4.2C10.2 4.2 12.3 5 14 6.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
        <path d="M4 9C5.1 8 6.5 7.5 8 7.5C9.5 7.5 10.9 8 12 9" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
        <path d="M6 11.2C6.6 10.7 7.3 10.5 8 10.5C8.7 10.5 9.4 10.7 10 11.2" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
        <circle cx="8" cy="13.2" r="0.9" fill="currentColor" />
      </svg>

      <!-- Loupe -->
      <button
        id="palette-trigger"
        type="button"
        aria-label="Ouvrir la recherche"
        class="hidden md:flex items-center justify-center w-7 h-7 rounded-md cursor-pointer hover-lift"
        style="color: var(--text-secondary); background: transparent; border: none;"
        title="Recherche (Ctrl+K)"
      >
        <svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="6.5" cy="6.5" r="4.5" stroke="currentColor" stroke-width="1.2" />
          <path d="M10 10L13.5 13.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
        </svg>
      </button>

      <span class="hidden md:block w-px h-3.5 mx-1" style="background: var(--border-subtle);"></span>

      <!-- Horloge -->
      <span
        id="mac-clock"
        class="font-mono text-[12px] tabular-nums tracking-tight cursor-default hover-lift px-2 py-1 rounded-md"
        style="color: var(--text-secondary);"
        title="Survolez pour les secondes"
      >
        --:--
      </span>

      <ThemeToggle />
    </div>
  </div>
</header>

<!-- COMMAND PALETTE -->
<div
  id="palette-backdrop"
  class="fixed inset-0 z-[100] hidden items-start justify-center pt-[15vh]"
  style="background: rgba(0, 0, 0, 0.5); backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px);"
>
  <div
    id="palette-panel"
    class="w-full max-w-lg mx-4 rounded-2xl border overflow-hidden palette-panel"
    style="
      background: var(--bg-surface);
      border-color: var(--glass-border);
      box-shadow: var(--shadow-lg), inset 0 1px 0 var(--glass-highlight);
    "
  >
    <div class="flex items-center gap-3 px-4 py-3 border-b" style="border-color: var(--border-subtle);">
      <svg width="16" height="16" viewBox="0 0 15 15" fill="none" style="color: var(--text-muted);">
        <circle cx="6.5" cy="6.5" r="4.5" stroke="currentColor" stroke-width="1.2" />
        <path d="M10 10L13.5 13.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
      </svg>
      <input
        id="palette-input"
        type="text"
        placeholder="Rechercher une section, un projet..."
        autocomplete="off"
        class="flex-1 bg-transparent border-none outline-none font-mono text-sm"
        style="color: var(--text-primary);"
      />
      <kbd class="font-mono text-[10px] px-1.5 py-0.5 rounded border" style="color: var(--text-muted); border-color: var(--border-subtle);">
        ESC
      </kbd>
    </div>
    <div id="palette-results" class="max-h-80 overflow-y-auto py-2"></div>
  </div>
</div>

<!-- TOAST (feedback pour copier email) -->
<div
  id="toast"
  class="fixed bottom-24 left-1/2 -translate-x-1/2 z-[110] hidden px-4 py-2 rounded-lg border font-mono text-xs"
  style="
    background: var(--bg-elevated);
    border-color: var(--glass-border);
    color: var(--text-primary);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  "
>
</div>

<script>
  // ═══════════════════════════════════════════
  // 1. MENUS FICHIER / ÉDITION / AFFICHAGE
  // ═══════════════════════════════════════════
  (function menus() {
    const wrappers = document.querySelectorAll('.menu-wrapper');

    function closeAll(except?: Element) {
      wrappers.forEach((w) => {
        if (w !== except) {
          const dd = w.querySelector('.menu-dropdown');
          dd?.classList.add('hidden');
        }
      });
    }

    wrappers.forEach((w) => {
      const trigger = w.querySelector('.menu-trigger');
      const dropdown = w.querySelector('.menu-dropdown');
      if (!trigger || !dropdown) return;

      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        const isHidden = dropdown.classList.contains('hidden');
        closeAll(w);
        if (isHidden) {
          dropdown.classList.remove('hidden');
        } else {
          dropdown.classList.add('hidden');
        }
      });

      // Fermer le menu après clic sur un item
      dropdown.querySelectorAll('.menu-item').forEach((item) => {
        item.addEventListener('click', () => {
          dropdown.classList.add('hidden');
        });
      });
    });

    // Fermer au clic extérieur
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!target.closest('.menu-wrapper')) {
        closeAll();
      }
    });

    // Fermer avec ESC
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeAll();
    });
  })();

  // ═══════════════════════════════════════════
  // 2. ACTIONS DES MENUS (thème, copier email)
  // ═══════════════════════════════════════════
  (function menuActions() {
    // Toggle thème
    document.querySelectorAll('[data-action="toggle-theme"]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const current = document.documentElement.dataset.theme;
        const next = current === 'ops' ? 'audit' : 'ops';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('theme', next);
      });
    });

    // Copier email
    document.querySelectorAll('[data-action="copy-email"]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText('contact@fhkdev.dev');
          showToast('Email copié : contact@fhkdev.dev');
        } catch {
          showToast('Impossible de copier');
        }
      });
    });

    function showToast(msg: string) {
      const toast = document.getElementById('toast');
      if (!toast) return;
      toast.textContent = msg;
      toast.classList.remove('hidden');
      setTimeout(() => toast.classList.add('hidden'), 2200);
    }
  })();

  // ═══════════════════════════════════════════
  // 3. BATTERIE
  // ═══════════════════════════════════════════
  (function battery() {
    let level = 87;
    const percentEl = document.getElementById('battery-percent');
    const fillEl = document.getElementById('battery-fill') as SVGRectElement | null;
    const iconEl = document.getElementById('battery-icon');
    if (!percentEl || !fillEl) return;

    function render() {
      percentEl.textContent = `${level}%`;
      const width = (level / 100) * 17.4;
      fillEl.setAttribute('width', String(Math.max(0, width)));

      if (level <= 5) {
        fillEl.setAttribute('fill', 'var(--mac-red)');
        iconEl?.classList.add('battery-critical');
      } else if (level <= 20) {
        fillEl.setAttribute('fill', 'var(--mac-yellow)');
        iconEl?.classList.remove('battery-critical');
      } else {
        fillEl.setAttribute('fill', 'currentColor');
        iconEl?.classList.remove('battery-critical');
      }
    }

    render();
    setInterval(() => {
      level = Math.max(5, level - 1);
      render();
    }, 20000);
  })();

  // ═══════════════════════════════════════════
  // 4. HORLOGE
  // ═══════════════════════════════════════════
  (function clock() {
    const el = document.getElementById('mac-clock');
    if (!el) return;

    let hovering = false;
    el.addEventListener('mouseenter', () => (hovering = true));
    el.addEventListener('mouseleave', () => (hovering = false));

    const days = ['dim.', 'lun.', 'mar.', 'mer.', 'jeu.', 'ven.', 'sam.'];

    function render() {
      const now = new Date();
      const day = days[now.getDay()] ?? '';
      const h = String(now.getHours()).padStart(2, '0');
      const m = String(now.getMinutes()).padStart(2, '0');

      if (hovering) {
        const s = String(now.getSeconds()).padStart(2, '0');
        el!.textContent = `${day} ${h}:${m}:${s}`;
      } else {
        el!.textContent = `${day} ${h}:${m}`;
      }
    }

    render();
    setInterval(render, 1000);
  })();

  // ═══════════════════════════════════════════
  // 5. COMMAND PALETTE
  // ═══════════════════════════════════════════
  (function palette() {
    const backdrop = document.getElementById('palette-backdrop');
    const input = document.getElementById('palette-input') as HTMLInputElement | null;
    const results = document.getElementById('palette-results');
    const trigger = document.getElementById('palette-trigger');
    if (!backdrop || !input || !results) return;

    const items = [
      { label: 'Accueil', href: '#hero', category: 'Section' },
      { label: 'Profil', href: '#profil', category: 'Section' },
      { label: 'Compétences', href: '#skills', category: 'Section' },
      { label: 'Stages', href: '#stages', category: 'Section' },
      { label: 'Certifications', href: '#certifs', category: 'Section' },
      { label: 'Lab perso', href: '#lab', category: 'Section' },
      { label: 'Projets', href: '#projets', category: 'Section' },
      { label: 'Contact', href: '#contact', category: 'Section' },
      { label: 'GitHub', href: 'https://github.com/fhkdev', category: 'Lien', external: true },
      { label: 'LinkedIn', href: 'https://linkedin.com/in/fhkdev', category: 'Lien', external: true },
      { label: 'Email', href: 'mailto:contact@fhkdev.dev', category: 'Lien', external: true },
      { label: 'Télécharger CV', href: '/cv.pdf', category: 'Action', external: true },
    ];

    let filtered = [...items];
    let selectedIndex = 0;

    function renderResults() {
      results!.innerHTML = '';

      if (filtered.length === 0) {
        const empty = document.createElement('div');
        empty.className = 'px-4 py-8 text-center font-mono text-xs';
        empty.style.color = 'var(--text-muted)';
        empty.textContent = 'Aucun résultat';
        results!.appendChild(empty);
        return;
      }

      filtered.forEach((item, i) => {
        const el = document.createElement('a');
        el.href = item.href;
        if (item.external) {
          el.target = '_blank';
          el.rel = 'noopener';
        }
        el.className = 'flex items-center justify-between px-4 py-2.5 cursor-pointer transition-colors';
        el.style.color = 'var(--text-primary)';
        el.style.background = i === selectedIndex ? 'var(--glass-bg)' : 'transparent';

        el.innerHTML = `
          <span class="text-sm">${item.label}</span>
          <span class="font-mono text-[10px]" style="color: var(--text-muted);">${item.category}</span>
        `;

        el.addEventListener('mouseenter', () => {
          selectedIndex = i;
          renderResults();
        });

        el.addEventListener('click', () => closePalette());
        results!.appendChild(el);
      });
    }

    function openPalette() {
      backdrop!.classList.remove('hidden');
      backdrop!.classList.add('flex');
      input!.value = '';
      filtered = [...items];
      selectedIndex = 0;
      renderResults();
      input!.focus();
    }

    function closePalette() {
      backdrop!.classList.add('hidden');
      backdrop!.classList.remove('flex');
    }

    function updateFilter(query: string) {
      const q = query.toLowerCase().trim();
      filtered = q ? items.filter((it) => it.label.toLowerCase().includes(q)) : [...items];
      selectedIndex = 0;
      renderResults();
    }

    input.addEventListener('input', () => updateFilter(input.value));

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closePalette();
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        selectedIndex = Math.min(filtered.length - 1, selectedIndex + 1);
        renderResults();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        selectedIndex = Math.max(0, selectedIndex - 1);
        renderResults();
      } else if (e.key === 'Enter') {
        const item = filtered[selectedIndex];
        if (item) {
          window.location.href = item.href;
          closePalette();
        }
      }
    });

    backdrop.addEventListener('click', (e) => {
      if (e.target === backdrop) closePalette();
    });

    trigger?.addEventListener('click', openPalette);

    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (backdrop.classList.contains('hidden')) {
          openPalette();
        } else {
          closePalette();
        }
      }
    });
  })();
</script>

<style>
  .menu-trigger {
    transition:
      transform 180ms ease,
      background-color 180ms ease,
      color 180ms ease;
  }

  .menu-trigger:hover {
    color: var(--text-primary) !important;
  }

  .menu-dropdown {
    animation: menu-in 180ms cubic-bezier(0.2, 0.9, 0.3, 1.1);
  }

  @keyframes menu-in {
    from {
      opacity: 0;
