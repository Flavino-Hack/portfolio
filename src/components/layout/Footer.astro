---
import Container from './Container.astro';

const year = new Date().getFullYear();
---

<footer class="border-t py-8" style="border-color: var(--border-subtle);">
  <Container size="wide">
    <div
      class="flex flex-col md:flex-row justify-between gap-4 font-mono text-xs"
      style="color: var(--text-muted);"
    >
      <p>© {year} — fhkdev</p>
      <p>Astro · Tailwind · TypeScript</p>
    </div>
  </Container>
</footer>
