---

import Container from '@components/layout/Container.astro';
import { getCloudinaryImage } from '@/content/projects/cloudinary-images';

interface Props {
  lang?: 'fr' | 'en';
  projectSlug?: string;
  title: string;
  description: string;
  category: string;
  tags: string[];
  role?: string;
  duration?: string;
  team?: string;
  year?: string;
  heroImage?: string;
  repo?: string;
  demo?: string;
  docs?: string;
  features?: { icon: string; title: string; text: string }[];
  previews?: { title: string; text: string; visual?: string }[];
  process?: { step: string; title: string; description: string }[];
  flow?: { num: number; title: string; text: string }[];
  architecture?: string;
  metrics?: { value: string; label: string }[];
}

const {
  lang = 'fr',
  projectSlug: passedSlug,
  title,
  description,
  category,
  tags,
  role,
  duration,
  team,
  year,
  heroImage,
  repo,
  demo,
  docs,
  features,
  previews,
  process,
  flow,
  architecture,
  metrics,
} = Astro.props;

const categoryLabels: Record<string, string> = {
  network: 'Réseau',
  dev: 'Développement',
  hybrid: 'Hybride',
  cyber: 'Cybersécurité',
};

const hasMeta = role || duration || team || year;

const projectSlug =
  passedSlug ||
  Astro.url.pathname
    .split('/')
    .filter(Boolean)
    .filter((p) => p !== 'projects')
    .pop() ||
  '';
const resolvedHeroImage = heroImage ? getCloudinaryImage(projectSlug, heroImage) : undefined;
const resolvedPreviews = previews?.map((p) => ({
  ...p,
  visual: p.visual ? getCloudinaryImage(projectSlug, p.visual) : undefined,
}));
---

  <Container size="narrow">
    <article class="project">
      <a href="/#projets" class="back-link font-mono text-xs">
        ← Tous les projets
      </a>

      <header class="project-hero">
        <span class="eyebrow">{categoryLabels[category] || category}</span>
        <h1>{title}</h1>
        <p class="subtitle">{description}</p>
        <div class="tags">
          {tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      </header>

      {hasMeta && (
        <div class="meta-bar">
          {role && (
            <div class="meta-item">
              <div class="label">Rôle</div>
              <div class="value">{role}</div>
            </div>
          )}
          {duration && (
            <div class="meta-item">
              <div class="label">Durée</div>
              <div class="value">{duration}</div>
            </div>
          )}
          {team && (
            <div class="meta-item">
              <div class="label">Équipe</div>
              <div class="value">{team}</div>
            </div>
          )}
          {year && (
            <div class="meta-item">
              <div class="label">Année</div>
              <div class="value">{year}</div>
            </div>
          )}
        </div>
      )}

      <div class="hero-image">
        {resolvedHeroImage ? (
          <img
            src={resolvedHeroImage}
            alt={title}
            style="cursor: zoom-in;"
            onclick={`window.openLightbox && window.openLightbox('${resolvedHeroImage}', '${title}')`}
          />
        ) : (
          <span>[ Visuel du projet — à remplacer ]</span>
        )}
      </div>

      <div class="project-content">
        <slot />
      </div>

      {features && features.length > 0 && (
        <section class="project-section">
          <div class="section-num">Fonctionnalités</div>
          <h2>Ce que fait le projet</h2>
          <div class="features">
            {features.map((f) => (
              <div class="feature-card">
                <div class="feature-icon">{f.icon}</div>
                <h3>{f.title}</h3>
                <p>{f.text}</p>
              </div>
            ))}
          </div>
        </section>
      )}

      {resolvedPreviews && resolvedPreviews.length > 0 && (
        <section class="project-section">
          <div class="section-num">Aperçu</div>
          <h2>En détail</h2>
          {resolvedPreviews.map((p, i) => (
            <div class={`zigzag ${i % 2 === 1 ? 'reverse' : ''}`}>
              <div class="text">
                <h3>{p.title}</h3>
                <p>{p.text}</p>
              </div>
              <div class="visual">
                {p.visual ? (
                  <img
                    src={p.visual}
                    alt={p.title}
                    style="cursor: zoom-in;"
                    onclick={`window.openLightbox && window.openLightbox('${p.visual}', '${p.title}')`}
                  />
                ) : (
                  <span>[ Visuel ]</span>
                )}
              </div>
            </div>
          ))}
        </section>
      )}

      {process && process.length > 0 && (
        <section class="project-section">
          <div class="section-num">Process</div>
          <h2>Comment je l'ai construit</h2>
          <div class="timeline">
            {process.map((p, i) => (
              <div class="timeline-item">
                <div class="timeline-marker">
                  <div class="dot"></div>
                  {i < process.length - 1 && <div class="line"></div>}
                </div>
                <div class="timeline-content">
                  <div class="step-num">{p.step}</div>
                  <h3>{p.title}</h3>
                  <p>{p.description}</p>
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      {flow && flow.length > 0 && (
        <section class="project-section">
          <div class="section-num">Démonstration</div>
          <h2>Comment ça marche</h2>
          <p>Le parcours en {flow.length} étapes clés.</p>
          <div class="flow">
            {flow.map((f, i) => (
              <>
                <div class="flow-step">
                  <div class="flow-num">{f.num}</div>
                  <h4>{f.title}</h4>
                  <p>{f.text}</p>
                </div>
                {i < flow.length - 1 && <div class="flow-arrow">→</div>}
              </>
            ))}
          </div>
        </section>
      )}

      {architecture && (
        <section class="project-section">
          <div class="section-num">Technique</div>
          <h2>Architecture</h2>
          <div class="arch-box" set:html={architecture} />
        </section>
      )}

      {metrics && metrics.length > 0 && (
        <section class="project-section">
          <div class="section-num">Résultats</div>
          <h2>Impact & apprentissages</h2>
          <div class="metrics">
            {metrics.map((m) => (
              <div class="metric">
                <div class="num">{m.value}</div>
                <div class="desc">{m.label}</div>
              </div>
            ))}
          </div>
        </section>
      )}

      {(repo || demo || docs) && (
        <section class="project-section">
          <div class="section-num">Liens</div>
          <h2>Découvrir le projet</h2>
          <div class="cta">
            {demo && (
              <a href={demo} target="_blank" rel="noopener" class="btn btn-primary">
                🔗 Voir la démo live
              </a>
            )}
            {repo && (
              <a href={repo} target="_blank" rel="noopener" class="btn btn-secondary">
                💻 Code source
              </a>
            )}
            {docs && (
              <a href={docs} target="_blank" rel="noopener" class="btn btn-secondary">
                📄 Documentation
              </a>
            )}
          </div>
        </section>
      )}

      <section class="project-section">
        <div class="section-num">Votre avis</div>
        <h2>Ce projet vous plaît ?</h2>
        <p>Laissez une note — ça m'aide à progresser.</p>
        <div class="rating-box">
          <div class="prompt">Notez ce projet</div>
          <div class="stars" id="stars">
            <span class="star" data-value="1">
              ★
            </span>
            <span class="star" data-value="2">
              ★
            </span>
            <span class="star" data-value="3">
              ★
            </span>
            <span class="star" data-value="4">
              ★
            </span>
            <span class="star" data-value="5">
              ★
            </span>
          </div>
          <div class="rating-label" id="ratingLabel">
            Cliquez sur une étoile
          </div>
        </div>
      </section>

      <section class="project-section">
        <div class="section-num">Commentaires</div>
        <h2>Laisser un commentaire</h2>
        <p>Une question, une suggestion ? Écrivez-moi.</p>
        <form class="comment-form" id="commentForm" autocomplete="off">
          <div class="form-row">
            <label for="name">Votre nom</label>
            <input type="text" id="name" placeholder="Ex: Marie Dupont" required />
          </div>
          <div class="form-row">
            <label for="message">Votre message</label>
            <textarea id="message" placeholder="Partagez votre avis..." required></textarea>
          </div>
          <button type="submit" class="btn btn-primary">
            Publier le commentaire
          </button>
        </form>
        <div class="comments-list" id="commentsList"></div>
      </section>

      <div class="footer-nav">
        <a href="/#projets">
          <div class="dir">← Tous les projets</div>
          <div class="name">Retour à la liste</div>
        </a>
        <a href="/#contact" class="next">
          <div class="dir">Me contacter →</div>
          <div class="name">Discutons de votre projet</div>
        </a>
      </div>
    </article>
  </Container>

<script>
  // ÉTOILES
  const stars = document.querySelectorAll('.star');
  const ratingLabel = document.getElementById('ratingLabel');
  const labels: Record<number, string> = {
    1: '😕 Pas convaincu',
    2: '🙂 Peut mieux faire',
    3: '👍 Pas mal',
    4: '😍 Très bon projet',
    5: '🔥 Excellent, bravo !',
  };
  let selected = 0;

  stars.forEach((star) => {
    star.addEventListener('mouseenter', () => {
      const val = Number((star as HTMLElement).dataset.value);
      stars.forEach((s) => {
        const sv = Number((s as HTMLElement).dataset.value);
        (s as HTMLElement).style.color = sv <= val ? 'var(--mac-yellow)' : 'var(--border-strong)';
      });
      if (ratingLabel) ratingLabel.textContent = labels[val] || '';
    });
    star.addEventListener('click', () => {
      selected = Number((star as HTMLElement).dataset.value);
      stars.forEach((s) => {
        const sv = Number((s as HTMLElement).dataset.value);
        (s as HTMLElement).style.color =
          sv <= selected ? 'var(--mac-yellow)' : 'var(--border-strong)';
      });
      if (ratingLabel) ratingLabel.textContent = labels[selected] || '';
    });
  });

  document.getElementById('stars')?.addEventListener('mouseleave', () => {
    stars.forEach((s) => {
      const sv = Number((s as HTMLElement).dataset.value);
      (s as HTMLElement).style.color = sv <= selected ? 'var(--mac-yellow)' : '';
    });
  });

  // COMMENTAIRES
  const form = document.getElementById('commentForm') as HTMLFormElement | null;
  const list = document.getElementById('commentsList');

  function createCommentElement(name: string, message: string): HTMLElement {
    const initials = name
      .split(' ')
      .filter(Boolean)
      .map((n) => n[0] ?? '')
      .slice(0, 2)
      .join('')
      .toUpperCase();

    const comment = document.createElement('div');
    comment.className = 'comment';

    const header = document.createElement('div');
    header.className = 'comment-header';

    const avatar = document.createElement('div');
    avatar.className = 'avatar';
    avatar.textContent = initials;

    const meta = document.createElement('div');
    meta.className = 'comment-meta';

    const nameEl = document.createElement('div');
    nameEl.className = 'comment-name';
    nameEl.textContent = name;

    const dateEl = document.createElement('div');
    dateEl.className = 'comment-date';
    dateEl.textContent = "À l'instant";

    meta.appendChild(nameEl);
    meta.appendChild(dateEl);
    header.appendChild(avatar);
    header.appendChild(meta);

    const text = document.createElement('p');
    text.className = 'comment-text';
    text.textContent = message;

    comment.appendChild(header);
    comment.appendChild(text);
    return comment;
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    e.stopPropagation();

    const nameInput = document.getElementById('name') as HTMLInputElement | null;
    const messageInput = document.getElementById('message') as HTMLTextAreaElement | null;
    if (!nameInput || !messageInput || !list) return;

    const name = nameInput.value.trim();
    const message = messageInput.value.trim();
    if (!name || !message) return;

    const comment = createCommentElement(name, message);
    list.prepend(comment);
    form.reset();

    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    if (btn) {
      const originalText = btn.textContent ?? '';
      const originalBg = btn.style.background;
      btn.textContent = '✓ Publié !';
      btn.style.background = 'var(--mac-green)';
      btn.style.color = 'var(--bg-primary)';
      setTimeout(() => {
        btn.textContent = originalText;
        btn.style.background = originalBg;
        btn.style.color = '';
      }, 1800);
    }
    comment.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  });
</script>

<style>
  .project {
    padding: 60px 0;
  }
  .back-link {
    display: inline-block;
    margin-bottom: 32px;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .back-link:hover {
    color: var(--accent);
  }

  .project-hero {
    text-align: center;
    padding-bottom: 48px;
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: 48px;
  }
  .eyebrow {
    display: inline-block;
    font-family: ui-monospace, monospace;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    padding: 6px 14px;
    border-radius: 100px;
    margin-bottom: 20px;
  }
  .project-hero h1 {
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: 16px;
    color: var(--text-primary);
  }
  .subtitle {
    font-size: 16px;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto 28px;
    line-height: 1.6;
  }
  .tags {
    display: flex;
    gap: 8px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .tag {
    font-family: ui-monospace, monospace;
    font-size: 11px;
    padding: 5px 10px;
    border: 1px solid var(--glass-border);
    border-radius: 8px;
    color: var(--text-secondary);
    background: var(--glass-bg);
  }

  .meta-bar {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 16px;
    padding: 20px;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: 16px;
    margin-bottom: 48px;
  }
  .meta-item {
    text-align: center;
  }
  .meta-item .label {
    font-family: ui-monospace, monospace;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-bottom: 6px;
  }
  .meta-item .value {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
  }

  .hero-image {
    width: 100%;
    aspect-ratio: 16 / 10;
    background: linear-gradient(135deg, var(--bg-surface) 0%, var(--bg-elevated) 100%);
    border: 1px solid var(--glass-border);
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    font-size: 13px;
    font-family: ui-monospace, monospace;
    margin-bottom: 60px;
    overflow: hidden;
  }
  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-content :global(h2) {
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-top: 48px;
    margin-bottom: 16px;
    color: var(--text-primary);
  }
  .project-content :global(p) {
    font-size: 15px;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: 16px;
  }
  .project-content :global(ul) {
    list-style: none;
    padding-left: 0;
    margin-bottom: 16px;
  }
  .project-content :global(li) {
    position: relative;
    padding-left: 20px;
    margin-bottom: 8px;
    line-height: 1.6;
    color: var(--text-secondary);
  }
  .project-content :global(li::before) {
    content: '▸';
    position: absolute;
    left: 0;
    color: var(--accent);
  }
  .project-content :global(strong) {
    color: var(--text-primary);
  }

  .project-section {
    margin-top: 60px;
    padding-top: 40px;
    border-top: 1px solid var(--border-subtle);
  }
  .section-num {
    font-family: ui-monospace, monospace;
    font-size: 11px;
    font-weight: 600;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 12px;
  }
  .project-section h2 {
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 20px;
    color: var(--text-primary);
  }
  .project-section > p {
    font-size: 15px;
    color: var(--text-secondary);
    margin-bottom: 24px;
  }

  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
    margin-top: 24px;
  }
  .feature-card {
    padding: 20px;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: 14px;
    transition:
      border-color 0.2s,
      transform 0.2s;
  }
  .feature-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .feature-icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    color: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
    font-size: 18px;
  }
  .feature-card h3 {
    font-size: 15px;
    font-weight: 600;
    margin-bottom: 6px;
    color: var(--text-primary);
  }
  .feature-card p {
    font-size: 13px;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.5;
  }

  .zigzag {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    align-items: center;
    margin: 32px 0;
  }
  .zigzag.reverse .text {
    order: 2;
  }
  .zigzag.reverse .visual {
    order: 1;
  }
  .zigzag .text h3 {
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 8px;
    color: var(--text-primary);
  }
  .zigzag .text p {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }
  .visual {
    aspect-ratio: 4 / 3;
    background: linear-gradient(135deg, var(--bg-surface), var(--bg-elevated));
    border: 1px solid var(--glass-border);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    font-size: 12px;
    font-family: ui-monospace, monospace;
    overflow: hidden;
  }
  .visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .timeline {
    margin-top: 24px;
  }
  .timeline-item {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 20px;
  }
  .timeline-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .timeline-marker .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--accent);
    border: 3px solid var(--bg-primary);
    box-shadow: 0 0 0 1px var(--accent);
    flex-shrink: 0;
    margin-top: 6px;
    position: relative;
    z-index: 1;
  }
  .timeline-marker .line {
    width: 2px;
    flex: 1;
    background: var(--border-strong);
    margin: 6px 0;
    opacity: 0.4;
  }
  .timeline-content {
    padding-bottom: 32px;
  }
  .step-num {
    font-family: ui-monospace, monospace;
    font-size: 10px;
    font-weight: 600;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 4px;
  }
  .timeline-content h3 {
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 6px;
    color: var(--text-primary);
  }
  .timeline-content p {
    font-size: 13px;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.6;
  }

  .flow {
    display: flex;
    align-items: stretch;
    gap: 12px;
    margin-top: 24px;
  }
  .flow-step {
    flex: 1;
    padding: 16px;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: 14px;
    text-align: center;
  }
  .flow-num {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--bg-primary);
    font-weight: 700;
    font-size: 13px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 10px;
  }
  .flow-step h4 {
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 6px;
    color: var(--text-primary);
  }
  .flow-step p {
    font-size: 12px;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.5;
  }
  .flow-arrow {
    display: flex;
    align-items: center;
    color: var(--accent);
    font-size: 18px;
    font-weight: 700;
  }

  .arch-box {
    padding: 28px;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: 16px;
    margin-top: 16px;
    text-align: center;
    font-family: ui-monospace, monospace;
    font-size: 12px;
    color: var(--text-secondary);
    line-height: 2;
  }

  .metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 16px;
    margin-top: 20px;
  }
  .metric {
    padding: 20px;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: 14px;
    text-align: center;
  }
  .metric .num {
    font-size: 28px;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .metric .desc {
    font-size: 11px;
