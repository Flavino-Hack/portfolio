---
import { avisParProjet } from '@/data/avis';
import Container from '@components/layout/Container.astro';
import { getCloudinaryImage } from '@/content/projects/cloudinary-images';
import ProjectAvis from '@/components/ui/ProjectAvis.astro';

interface Props {
  lang?: 'fr' | 'en';
  projectSlug?: string;
  title: string;
  description: string;
  category: string;
  tags: string[];
  role?: string;
  duration?: string;
  team?: string;
  year?: string;
  heroImage?: string;
  repo?: string;
  demo?: string;
  docs?: string;
  features?: { icon: string; title: string; text: string }[];
  previews?: { title: string; text: string; visual?: string }[];
  process?: { step: string; title: string; description: string }[];
  flow?: { num: number; title: string; text: string }[];
  architecture?: string;
  metrics?: { value: string; label: string }[];
}

const {
  lang = 'fr',
  projectSlug: passedSlug,
  title,
  description,
  category,
  tags,
  role,
  duration,
  team,
  year,
  heroImage,
  repo,
  demo,
  docs,
  features,
  previews,
  process,
  flow,
  architecture,
  metrics,
} = Astro.props;

const categoryLabels: Record<string, string> = {
  network: 'Réseau',
  dev: 'Développement',
  hybrid: 'Hybride',
  cyber: 'Cybersécurité',
};

const hasMeta = role || duration || team || year;

const projectSlug =
  passedSlug ||
  Astro.url.pathname
    .split('/')
    .filter(Boolean)
    .filter((p) => p !== 'projects')
    .pop() ||
  '';
const resolvedHeroImage = heroImage ? getCloudinaryImage(projectSlug, heroImage) : undefined;
const resolvedPreviews = previews?.map((p) => ({
  ...p,
  visual: p.visual ? getCloudinaryImage(projectSlug, p.visual) : undefined,
}));
---

<Container size="narrow">
  <article class="project">
    <a href="/#projets" class="back-link font-mono text-xs">
      ← Tous les projets
    </a>

    <header class="project-hero">
      <span class="eyebrow">{categoryLabels[category] || category}</span>
      <h1>{title}</h1>
      <p class="subtitle">{description}</p>
      <div class="tags">
        {tags.map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    </header>

    {hasMeta && (
      <div class="meta-bar">
        {role && (
          <div class="meta-item">
            <div class="label">Rôle</div>
            <div class="value">{role}</div>
          </div>
        )}
        {duration && (
          <div class="meta-item">
            <div class="label">Durée</div>
            <div class="value">{duration}</div>
          </div>
        )}
        {team && (
          <div class="meta-item">
            <div class="label">Équipe</div>
            <div class="value">{team}</div>
          </div>
        )}
        {year && (
          <div class="meta-item">
            <div class="label">Année</div>
            <div class="value">{year}</div>
          </div>
        )}
      </div>
    )}

    <div class="hero-image">
      {resolvedHeroImage ? (
        <img
          src={resolvedHeroImage}
          alt={title}
          style="cursor: zoom-in;"
          onclick={`window.openLightbox && window.openLightbox('${resolvedHeroImage}', '${title}')`}
        />
      ) : (
        <span>[ Visuel du projet — à remplacer ]</span>
      )}
    </div>

    <div class="project-content">
      <slot />
    </div>

    {features && features.length > 0 && (
      <section class="project-section">
        <div class="section-num">Fonctionnalités</div>
        <h2>Ce que fait le projet</h2>
        <div class="features">
          {features.map((f) => (
            <div class="feature-card">
              <div class="feature-icon">{f.icon}</div>
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    {resolvedPreviews && resolvedPreviews.length > 0 && (
      <section class="project-section">
        <div class="section-num">Aperçu</div>
        <h2>En détail</h2>
        {resolvedPreviews.map((p, i) => (
          <div class={`zigzag ${i % 2 === 1 ? 'reverse' : ''}`}>
            <div class="text">
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </div>
            <div class="visual">
              {p.visual ? (
                <img
                  src={p.visual}
                  alt={p.title}
                  style="cursor: zoom-in;"
                  onclick={`window.openLightbox && window.openLightbox('${p.visual}', '${p.title}')`}
                />
              ) : (
                <span>[ Visuel ]</span>
              )}
            </div>
          </div>
        ))}
      </section>
    )}

    {process && process.length > 0 && (
      <section class="project-section">
        <div class="section-num">Process</div>
        <h2>Comment je l'ai construit</h2>
        <div class="timeline">
          {process.map((p, i) => (
            <div class="timeline-item">
              <div class="timeline-marker">
                <div class="dot"></div>
                {i < process.length - 1 && <div class="line"></div>}
              </div>
              <div class="timeline-content">
                <div class="step-num">{p.step}</div>
                <h3>{p.title}</h3>
                <p>{p.description}</p>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    {flow && flow.length > 0 && (
      <section class="project-section">
        <div class="section-num">Démonstration</div>
        <h2>Comment ça marche</h2>
        <p>Le parcours en {flow.length} étapes clés.</p>
        <div class="flow">
          {flow.map((f, i) => (
            <>
              <div class="flow-step">
                <div class="flow-num">{f.num}</div>
                <h4>{f.title}</h4>
                <p>{f.text}</p>
              </div>
              {i < flow.length - 1 && <div class="flow-arrow">→</div>}
            </>
          ))}
        </div>
      </section>
    )}

    {architecture && (
      <section class="project-section">
        <div class="section-num">Technique</div>
        <h2>Architecture</h2>
        <div class="arch-box" set:html={architecture} />
      </section>
    )}

    {metrics && metrics.length > 0 && (
      <section class="project-section">
        <div class="section-num">Résultats</div>
        <h2>Impact & apprentissages</h2>
        <div class="metrics">
          {metrics.map((m) => (
            <div class="metric">
              <div class="num">{m.value}</div>
              <div class="desc">{m.label}</div>
            </div>
          ))}
        </div>
      </section>
    )}

    {(repo || demo || docs) && (
      <section class="project-section">
        <div class="section-num">Liens</div>
        <h2>Découvrir le projet</h2>
        <div class="cta">
          {demo && (
            <a href={demo} target="_blank" rel="noopener" class="btn btn-primary">
              🔗 Voir la démo live
            </a>
          )}
          {repo && (
            <a href={repo} target="_blank" rel="noopener" class="btn btn-secondary">
              💻 Code source
            </a>
          )}
          {docs && (
            <a href={docs} target="_blank" rel="noopener" class="btn btn-secondary">
              📄 Documentation
            </a>
          )}
        </div>
      </section>
    )}

    <!-- LE COMPOSANT DES AVIS EST ICI -->
    <ProjectAvis slug={projectSlug} />

    <div class="footer-nav">
      <a href="/#projets">
        <div class="dir">← Tous les projets</div>
        <div class="name">Retour à la liste</div>
      </a>
      <a href="/#contact" class="next">
        <div class="dir">Me contacter →</div>
        <div class="name">Discutons de votre projet</div>
      </a>
    </div>
  </article>
</Container>

<style>
  .project {
    padding: 60px 0;
  }
  .back-link {
    display: inline-block;
    margin-bottom: 32px;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .back-link:hover {
    color: var(--accent);
  }

  .project-hero {
    text-align: center;
    padding-bottom: 48px;
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: 48px;
  }
  .eyebrow {
    display: inline-block;
    font-family: ui-monospace, monospace;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    padding: 6px 14px;
    border-radius: 100px;
    margin-bottom: 20px;
  }
  .project-hero h1 {
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: 16px;
    color: var(--text-primary);
  }
  .subtitle {
    font-size: 16px;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto 28px;
    line-height: 1.6;
  }
  .tags {
    display: flex;
    gap: 8px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .tag {
    font-family: ui-monospace, monospace;
    font-size: 11px;
    padding: 5px 10px;
    border: 1px solid var(--glass-border);
    border-radius: 8px;
    color: var(--text-secondary);
    background: var(--glass-bg);
  }

  .meta-bar {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 16px;
    padding: 20px;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: 16px;
    margin-bottom: 48px;
  }
  .meta-item {
    text-align: center;
  }
  .meta-item .label {
    font-family: ui-monospace, monospace;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-bottom: 6px;
  }
  .meta-item .value {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
  }

  .hero-image {
    width: 100%;
    aspect-ratio: 16 / 10;
    background: linear-gradient(135deg, var(--bg-surface) 0%, var(--bg-elevated) 100%);
    border: 1px solid var(--glass-border);
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    font-size: 13px;
    font-family: ui-monospace, monospace;
    margin-bottom: 60px;
    overflow: hidden;
  }
  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-content :global(h2) {
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-top: 48px;
    margin-bottom: 16px;
    color: var(--text-primary);
  }
  .project-content :global(p) {
    font-size: 15px;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: 16px;
  }
  .project-content :global(ul) {
    list-style: none;
    padding-left: 0;
    margin-bottom: 16px;
  }
  .project-content :global(li) {
    position: relative;
    padding-left: 20px;
    margin-bottom: 8px;
    line-height: 1.6;
    color: var(--text-secondary);
  }
  .project-content :global(li::before) {
    content: '▸';
    position: absolute;
    left: 0;
    color: var(--accent);
  }
  .project-content :global(strong) {
    color: var(--text-primary);
  }

  .project-section {
    margin-top: 60px;
    padding-top: 40px;
    border-top: 1px solid var(--border-subtle);
  }
  .section-num {
    font-family: ui-monospace, monospace;
    font-size: 11px;
    font-weight: 600;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 12px;
  }
  .project-section h2 {
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 20px;
    color: var(--text-primary);
  }
  .project-section > p {
    font-size: 15px;
    color: var(--text-secondary);
    margin-bottom: 24px;
  }

  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
    margin-top: 24px;
  }
  .feature-card {
    padding: 20px;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: 14px;
    transition:
      border-color 0.2s,
      transform 0.2s;
  }
  .feature-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .feature-icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    color: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
    font-size: 18px;
  }
  .feature-card h3 {
    font-size: 15px;
    font-weight: 600;
    margin-bottom: 6px;
    color: var(--text-primary);
  }
  .feature-card p {
    font-size: 13px;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.5;
  }

  .zigzag {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    align-items: center;
    margin: 32px 0;
  }
  .zigzag.reverse .text {
    order: 2;
  }
  .zigzag.reverse .visual {
    order: 1;
  }
  .zigzag .text h3 {
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 8px;
    color: var(--text-primary);
  }
  .zigzag .text p {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }
  .visual {
    aspect-ratio: 4 / 3;
    background: linear-gradient(135deg, var(--bg-surface), var(--bg-elevated));
    border: 1px solid var(--glass-border);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    font-size: 12px;
    font-family: ui-monospace, monospace;
    overflow: hidden;
  }
  .visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .timeline {
    margin-top: 24px;
  }
  .timeline-item {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 20px;
  }
  .timeline-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .timeline-marker .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--accent);
    border: 3px solid var(--bg-primary);
    box-shadow: 0 0 0 1px var(--accent);
    flex-shrink: 0;
    margin-top: 6px;
    position: relative;
    z-index: 1;
  }
  .timeline-marker .line {
    width: 2px;
    flex: 1;
    background: var(--border-strong);
    margin: 6px 0;
    opacity: 0.4;
  }
  .timeline-content {
    padding-bottom: 32px;
  }
  .step-num {
    font-family: ui-monospace, monospace;
    font-size: 10px;
    font-weight: 600;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 4px;
  }
  .timeline-content h3 {
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 6px;
    color: var(--text-primary);
  }
  .timeline-content p {
    font-size: 13px;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.6;
  }

  .flow {
    display: flex;
    align-items: stretch;
    gap: 12px;
    margin-top: 24px;
  }
  .flow-step {
    flex: 1;
    padding: 16px;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: 14px;
    text-align: center;
  }
  .flow-num {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--bg-primary);
    font-weight: 700;
    font-size: 13px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 10px;
  }
  .flow-step h4 {
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 6px;
    color: var(--text-primary);
  }
  .flow-step p {
    font-size: 12px;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.5;
  }
  .flow-arrow {
    display: flex;
    align-items: center;
    color: var(--accent);
    font-size: 18px;
    font-weight: 700;
  }

  .arch-box {
    padding: 28px;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: 16px;
    margin-top: 16px;
    text-align: center;
    font-family: ui-monospace, monospace;
    font-size: 12px;
    color: var(--text-secondary);
    line-height: 2;
  }

  .metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 16px;
    margin-top: 20px;
  }
  .metric {
    padding: 20px;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: 14px;
    text-align: center;
  }
  .metric .num {
    font-size: 28px;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .metric .desc {
    font-size: 11px;
    color: var(--text-muted);
    margin-top: 6px;
  }

  .cta {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .btn {
    padding: 10px 18px;
    border-radius: 10px;
    font-family: ui-monospace, monospace;
    font-size: 12px;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    border: 1px solid transparent;
  }
  .btn-primary {
    background: var(--accent);
    color: var(--bg-primary);
  }
  .btn-primary:hover {
    transform: translateY(-2px);
    filter: brightness(1.1);
  }
  .btn-secondary {
    background: var(--glass-bg);
    color: var(--text-primary);
    border-color: var(--glass-border);
  }
  .btn-secondary:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .footer-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    padding-top: 40px;
    border-top: 1px solid var(--border-subtle);
    margin-top: 60px;
  }
  .footer-nav a {
    padding: 18px;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: 14px;
    text-decoration: none;
    color: var(--text-primary);
    transition:
      border-color 0.2s,
      transform 0.2s;
  }
  .footer-nav a:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .footer-nav .dir {
    font-family: ui-monospace, monospace;
    font-size: 10px;
    color: var(--text-muted);
    margin-bottom: 4px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .footer-nav .name {
    font-weight: 600;
    font-size: 13px;
  }
  .footer-nav .next {
    text-align: right;
  }

  @media (max-width: 700px) {
    .zigzag {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .zigzag.reverse .text {
      order: 1;
    }
    .zigzag.reverse .visual {
      order: 2;
    }
    .flow {
      flex-direction: column;
    }
    .flow-arrow {
      transform: rotate(90deg);
      justify-content: center;
    }
    .footer-nav {
      grid-template-columns: 1fr;
    }
    .footer-nav .next {
      text-align: left;
    }
  }

  /* Blocs de code */
  .project-content :global(pre) {
    background: #0f172a;
    border: 1px solid var(--glass-border);
    border-radius: 12px;
    padding: 1rem 1.25rem;
    overflow-x: auto;
    margin: 1rem 0 1.5rem 0;
  }

  .project-content :global(pre code) {
    color: #e2e8f0;
    font-size: 0.82rem;
    line-height: 1.7;
    display: block;
    white-space: pre;
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    background: transparent;
    padding: 0;
    border: none;
  }

  .project-content :global(code) {
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-size: 0.85em;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    padding: 0.15em 0.4em;
    border-radius: 4px;
    color: var(--accent);
  }

  /* Tableaux */
  .project-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0;
    font-size: 0.9rem;
  }

  .project-content :global(th) {
    background: var(--bg-surface);
    color: var(--text-primary);
    padding: 0.75rem 1rem;
    text-align: left;
    font-weight: 600;
    border-bottom: 1px solid var(--glass-border);
  }

  .project-content :global(td) {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--border-subtle);
    color: var(--text-secondary);
  }

  .project-content :global(tr:last-child td) {
    border-bottom: none;
  }
</style>