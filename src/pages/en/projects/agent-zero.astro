  title="Agent Zero — Autonomous AI Assistant"
  description="Deployment of an autonomous conversational AI agent with Docker, Google Gemini and OpenRouter on Kali Linux"
  lang="en"
>
  <ProjectLayout
    lang="en"
    projectSlug="agent-zero"
    title="Agent Zero — Autonomous AI Assistant"
    description="Deployment of an autonomous conversational AI agent with Docker, Google Gemini and OpenRouter on Kali Linux. Web interface, quota management, code generation."
    category="dev"
    tags={['Python', 'Docker', 'Gemini', 'OpenRouter', 'Kali Linux', 'Supervisor', 'Flask']}
    role="Developer & Network Engineer"
    duration="1 week"
    team="Solo"
    year="2026"
    heroImage="logo"
    features={[
      {
        icon: '🤖',
        title: 'Autonomous AI agent',
        text: 'Agent Zero framework deployed in Docker, conversational web interface, memory and file management.',
      },
      {
        icon: '🧠',
        title: 'Multi-model',
        text: 'Configuration of Google Gemini (free, 20 req/day) and OpenRouter (paid) to compare cost and quality.',
      },
      {
        icon: '💻',
        title: 'Code generation',
        text: 'The agent generated a complete and functional Flappy Bird game in HTML/CSS/JS from a single natural language instruction.',
      },
      {
