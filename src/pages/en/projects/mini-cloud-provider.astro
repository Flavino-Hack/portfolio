---
import BaseLayout from '@layouts/BaseLayout.astro';
import ProjectLayout from '@layouts/ProjectLayout.astro';
import { getCloudinaryImage, cloudinaryImages } from '@/content/projects/cloudinary-images';

const img = (key: string) => getCloudinaryImage('mini-cloud-provider', key);

// 1. Code Block: Pydantic Data Models and Creation Endpoint
const pythonApiSnippet = `from pydantic import BaseModel
import docker

class VPSCreate(BaseModel):
    name: str
    ram_mb: int
    cpu_limit: float
    storage_gb: int
    username: str
    password: str

@app.post("/vps/create")
async def create_vps(vps_data: VPSCreate):
    vps_id = str(uuid.uuid4())[:8]
    container_name = f"vps-{vps_data.name}-{vps_id}"
    volume_name = f"{container_name}-data"
    
    # 1. Create persistent volume
    client.volumes.create(name=volume_name, driver="local")
    
    # 2. Provisioning with strict isolation (Cgroups)
    container = client.containers.run(
        "mini-cloud-provider_vps-base",
        user="root",
        detach=True,
        tty=True,
        mem_limit=f"{vps_data.ram_mb}m",                # Strict RAM limit (OOM Killer triggered beyond this)
        cpu_quota=int(vps_data.cpu_limit * 100000),     # Ex: 0.5 vCPU = 50000µs of access...
        cpu_period=100000,                              # ...per period of 100000µs (0.1s)
        network="vps-network",
        volumes={volume_name: {'bind': '/data', 'mode': 'rw'}},
        ports={'7681/tcp': None},                       # Dynamic port mapping by the host
        command=f"ttyd -p 7681 -c '{vps_data.username}:{vps_data.password}' -W bash"
    )
    
    # 3. Retrieve the dynamic port assigned by Docker
    container.reload()
    host_port = container.attrs['NetworkSettings']['Ports']['7681/tcp'][0]['HostPort']
    
    return {"url": f"http://{vps_data.name}.127.0.0.1.nip.io:{host_port}", "status": "running"}`;

// 2. Code Block: Optimized Dockerfile for the base image
const dockerfileSnippet = `# Use a minimal image to reduce attack surface and boot time
FROM debian:bookworm-slim

# Install diagnostic tools and web terminal server
RUN apt-get update && apt-get install -y wget curl htop nano && \\
    # Download static ttyd binary (no heavy Node.js dependencies)
    wget https://github.com/tsl0922/ttyd/releases/download/1.7.4/ttyd.x86_64 -O /usr/local/bin/ttyd && \\
    chmod +x /usr/local/bin/ttyd && \\
    # Aggressive cleanup to minimize final image size
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Create mount point for persistent storage
RUN mkdir -p /data && chmod 777 /data

EXPOSE 7681

# Default command is injected dynamically by the Python SDK, 
# but this serves as a secure fallback.
CMD ["ttyd", "-p", "7681", "-W", "bash"]`;

// 3. Code Block: Docker Compose Orchestration
const composeSnippet = `version: '3.8'
services:
  backend:
    build: ./backend
    ports:
      - "8000:8000"
    volumes:
      # Mount Docker socket to allow backend to control the daemon
      - /var/run/docker.sock:/var/run/docker.sock
    environment:
      - DOCKER_NETWORK_NAME=mini-cloud-provider_vps-network
    networks:
      - vps-network

networks:
  vps-network:
    driver: bridge # Network isolation of VPS from the host network`;

// 4. Log Excerpt: Proof of resource isolation (docker stats)
const dockerStatsLog = `CONTAINER ID   NAME                 CPU %     MEM USAGE / LIMIT     MEM %     NET I/O
a1b2c3d4e5f6   vps-prod-web-1001    1.25%     45.2MiB / 512MiB      8.82%     1.2MB / 300KB
b2c3d4e5f6a1   vps-db-1002          12.4%     180.5MiB / 1024MiB   17.6%     5.4MB / 1.1MB`;

// 5. Python script for persistence and load testing
const pythonMonitorSnippet = `import time, os
from datetime import datetime

os.makedirs("/data/logs", exist_ok=True)
print("🚀 Starting persistence monitor...")

while True:
    timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    log_file = "/data/logs/monitor.log"
    
    # Simulate disk write to test persistent volume
    with open(log_file, "a") as f:
        f.write(f"[{timestamp}] VPS active - Disk write OK\\n")
    
    time.sleep(5)`;

// ✅ Retrieve all project videos for the gallery
const videos = Object.entries(cloudinaryImages['mini-cloud-provider'] || {})
  .filter(([key, url]) => url.includes('/video/upload/'))
  .map(([key, url]) => ({ key, url }));
