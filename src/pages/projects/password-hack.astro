---
import BaseLayout from '@layouts/BaseLayout.astro';
import ProjectLayout from '@layouts/ProjectLayout.astro';
import { getCloudinaryImage, cloudinaryImages } from '@/content/projects/cloudinary-images';

const img = (key: string) => getCloudinaryImage('password-hack', key);

// Bloc de code pour l'extraction du hash
const zip2johnCmd = `# Extraction du hash de l'archive ZIP
zip2john archives/faible.zip > hashs/faible.hash
cat hashs/faible.hash
# Résultat : $pkzip2$*1*1*0*0*...`;

// Bloc de code pour l'attaque John
const johnCmd = `# Attaque par dictionnaire
time john --wordlist=rockyou.txt hashs/faible.hash

# Résultat :
# password (faible.zip/secret.txt)
# 1g 0:00:00:00 DONE ... 12.50g/s`;

// Bloc de code pour la défense Python
const pythonDefense = `# Vérification HIBP (k-anonymity)
import hashlib, urllib.request

def check_pwned(password):
    sha1 = hashlib.sha1(password.encode('utf-8')).hexdigest().upper()
    prefix, suffix = sha1[:5], sha1[5:]
    url = f"https://api.pwnedpasswords.com/range/{prefix}"
    # ... (reste du code)`;

// ✅ Récupération des vidéos (si tu en as)
const videos = Object.entries(cloudinaryImages['password-hack'] || {})
  .filter(([key, url]) => url.includes('/video/upload/'))
  .map(([key, url]) => ({ key, url }));
