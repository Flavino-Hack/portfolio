---
import { getCollection, render } from 'astro:content';
import ProjectLayout from '@layouts/ProjectLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<ProjectLayout
  projectSlug={project.id}
  title={project.data.title}
  description={project.data.description}
  category={project.data.category}
  tags={project.data.tags}
  role={project.data.role}
  duration={project.data.duration}
  team={project.data.team}
  year={project.data.year}
  heroImage={project.data.heroImage}
  repo={project.data.repo}
  demo={project.data.demo}
  docs={project.data.docs}
  features={project.data.features}
  previews={project.data.previews}
  process={project.data.process}
  flow={project.data.flow}
  architecture={project.data.architecture}
  metrics={project.data.metrics}
>
  <Content />
</ProjectLayout>