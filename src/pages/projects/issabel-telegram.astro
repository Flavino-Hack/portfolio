---
import BaseLayout from '@layouts/BaseLayout.astro';
import ProjectLayout from '@layouts/ProjectLayout.astro';
import { getCloudinaryImage, cloudinaryImages } from '@/content/projects/cloudinary-images';

const img = (key: string) => getCloudinaryImage('issabel-telegram', key);

// Bloc de code pour le script Bash
const bashScript = `#!/bin/bash
TOKEN="VOTRE_TOKEN_TELEGRAM"
CHAT_ID="VOTRE_CHAT_ID"
CALLER=$1
EXTEN=$2
MESSAGE="📞 Appel entrant sur le $EXTEN de la part du $CALLER"

curl -s -X POST "https://api.telegram.org/bot$TOKEN/sendMessage" -d chat_id="$CHAT_ID" -d text="$MESSAGE"`;

// Bloc de code pour le dialplan
const dialplanConfig = `[telegram-alert]
exten => s,1,NoOp(--- LANCEMENT DU SCRIPT TELEGRAM ---)
same => n,System(/usr/local/bin/send_telegram_alert.sh "&#36;&#123;CALLERID(num)&#125;" "1003")
same => n,Hangup()

[from-internal-custom]
exten => 9999,1,NoOp(Redirection vers le script Telegram)
same => n,Goto(telegram-alert,s,1)`;

// Extrait de log pour l'erreur TCP/UDP
const asteriskLog = `[2026-11-13 02:19:32] ERROR[3822]: res_pjsip.c:1769 endpt_send_request: Error 171064 'Unsuitable transport selected (PJSIP_ETPNOTSUITABLE)' sending OPTIONS request to endpoint 1003
[2026-11-13 02:19:32] ERROR[3822]: res_pjsip/pjsip_options.c:921 sip_options_qualify_contact: Unable to send request to qualify contact sip:1003@192.168.1.68:48799;transport=TCP
[2026-11-13 02:19:32] ERROR[4416]: res_pjsip.c:1769 endpt_send_request: Error 171064 'Unsuitable transport selected (PJSIP_ETPNOTSUITABLE)' sending NOTIFY request to endpoint 1003`;

// ✅ Récupération de toutes les vidéos
const videos = Object.entries(cloudinaryImages['issabel-telegram'] || {})
  .filter(([key, url]) => url.includes('/video/upload/'))
  .map(([key, url]) => ({ key, url }));
