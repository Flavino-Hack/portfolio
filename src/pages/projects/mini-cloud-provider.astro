---
import BaseLayout from '@layouts/BaseLayout.astro';
import ProjectLayout from '@layouts/ProjectLayout.astro';
import { getCloudinaryImage, cloudinaryImages } from '@/content/projects/cloudinary-images';

const img = (key: string) => getCloudinaryImage('mini-cloud-provider', key);

// 1. Bloc de code : Modèles de données Pydantic et Endpoint de création
const pythonApiSnippet = `from pydantic import BaseModel
import docker

class VPSCreate(BaseModel):
    name: str
    ram_mb: int
    cpu_limit: float
    storage_gb: int
    username: str
    password: str

@app.post("/vps/create")
async def create_vps(vps_data: VPSCreate):
    vps_id = str(uuid.uuid4())[:8]
    container_name = f"vps-{vps_data.name}-{vps_id}"
    volume_name = f"{container_name}-data"
    
    # 1. Création du volume persistant
    client.volumes.create(name=volume_name, driver="local")
    
    # 2. Provisionnement avec isolation stricte (Cgroups)
    container = client.containers.run(
        "mini-cloud-provider_vps-base",
        user="root",
        detach=True,
        tty=True,
        mem_limit=f"{vps_data.ram_mb}m",                # Limite RAM stricte (OOM Killer activé au-delà)
        cpu_quota=int(vps_data.cpu_limit * 100000),     # Ex: 0.5 vCPU = 50000µs d'accès...
        cpu_period=100000,                              # ...par période de 100000µs (0.1s)
        network="vps-network",
        volumes={volume_name: {'bind': '/data', 'mode': 'rw'}},
        ports={'7681/tcp': None},                       # Mapping de port dynamique par l'hôte
        command=f"ttyd -p 7681 -c '{vps_data.username}:{vps_data.password}' -W bash"
    )
    
    # 3. Récupération du port dynamique attribué par Docker
    container.reload()
    host_port = container.attrs['NetworkSettings']['Ports']['7681/tcp'][0]['HostPort']
    
    return {"url": f"http://{vps_data.name}.127.0.0.1.nip.io:{host_port}", "status": "running"}`;

// 2. Bloc de code : Dockerfile optimisé de l'image de base
const dockerfileSnippet = `# Utilisation d'une image minimale pour réduire la surface d'attaque et le temps de boot
FROM debian:bookworm-slim

# Installation des outils de diagnostic et du serveur de terminal web
RUN apt-get update && apt-get install -y wget curl htop nano && \\
    # Téléchargement du binaire statique ttyd (pas de dépendances Node.js lourdes)
    wget https://github.com/tsl0922/ttyd/releases/download/1.7.4/ttyd.x86_64 -O /usr/local/bin/ttyd && \\
    chmod +x /usr/local/bin/ttyd && \\
    # Nettoyage agressif pour minimiser la taille de l'image finale
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Création du point de montage pour le stockage persistant
RUN mkdir -p /data && chmod 777 /data

EXPOSE 7681

# La commande par défaut est injectée dynamiquement par le SDK Python, 
# mais celle-ci sert de fallback sécurisé.
CMD ["ttyd", "-p", "7681", "-W", "bash"]`;

// 3. Bloc de code : Orchestration Docker Compose
const composeSnippet = `version: '3.8'
services:
  backend:
    build: ./backend
    ports:
      - "8000:8000"
    volumes:
      # Montage du socket Docker pour permettre au backend de contrôler le daemon
      - /var/run/docker.sock:/var/run/docker.sock
    environment:
      - DOCKER_NETWORK_NAME=mini-cloud-provider_vps-network
    networks:
      - vps-network

networks:
  vps-network:
    driver: bridge # Isolation réseau des VPS par rapport au réseau hôte`;

// 4. Extrait de log : Preuve de l'isolation des ressources (docker stats)
const dockerStatsLog = `CONTAINER ID   NAME                 CPU %     MEM USAGE / LIMIT     MEM %     NET I/O
a1b2c3d4e5f6   vps-prod-web-1001    1.25%     45.2MiB / 512MiB      8.82%     1.2MB / 300KB
b2c3d4e5f6a1   vps-db-1002          12.4%     180.5MiB / 1024MiB   17.6%     5.4MB / 1.1MB`;

// 5. Script Python de test de persistance et de charge
const pythonMonitorSnippet = `import time, os
from datetime import datetime

os.makedirs("/data/logs", exist_ok=True)
print("🚀 Démarrage du monitor de persistance...")

while True:
    timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    log_file = "/data/logs/monitor.log"
    
    # Simulation d'écriture disque pour tester le volume persistant
    with open(log_file, "a") as f:
        f.write(f"[{timestamp}] VPS actif - Écriture disque OK\\n")
    
    time.sleep(5)`;

// ✅ Récupération de toutes les vidéos du projet pour la galerie
const videos = Object.entries(cloudinaryImages['mini-cloud-provider'] || {})
  .filter(([key, url]) => url.includes('/video/upload/'))
  .map(([key, url]) => ({ key, url }));
