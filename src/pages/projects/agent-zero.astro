---
import BaseLayout from '@layouts/BaseLayout.astro';
import ProjectLayout from '@layouts/ProjectLayout.astro';
import { getCloudinaryImage } from '@/content/projects/cloudinary-images';

const img = (key: string) => getCloudinaryImage('agent-zero', key);
---

<BaseLayout
  title="Agent Zero — Assistant IA Autonome"
  description="Déploiement d'un agent IA conversationnel autonome avec Docker, Google Gemini et OpenRouter sur Kali Linux"
  lang="fr"
>
  <ProjectLayout
    lang="fr"
    projectSlug="agent-zero"
    title="Agent Zero — Assistant IA Autonome"
    description="Déploiement d'un agent IA conversationnel autonome avec Docker, Google Gemini et OpenRouter sur Kali Linux. Interface web, gestion des quotas, création de code."
    category="dev"
    tags={['Python', 'Docker', 'Gemini', 'OpenRouter', 'Kali Linux', 'Supervisor', 'Flask']}
    role="Développeur & Ingénieur Réseau"
    duration="1 semaine"
    team="Solo"
    year="2026"
    heroImage="logo"
    features={[
      {
        icon: '🤖',
        title: 'Agent IA autonome',
        text: 'Framework Agent Zero déployé en Docker, interface web conversationnelle, gestion de la mémoire et des fichiers.',
      },
      {
        icon: '🧠',
        title: 'Multi-modèles',
        text: 'Configuration de Google Gemini (gratuit, 20 req/jour) et OpenRouter (payant) pour comparer les coûts et la qualité.',
